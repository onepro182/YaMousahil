{"n":91,"name":"الشمس","type":"مكية","count":15,"page":595,"verses":[{"n":1,"t":"وَالْقَمَرِ إِذَا تَلَيٰهَا"},{"n":2,"t":"وَالنَّه۪ارِ إِذَا جَلَّيٰهَا"},{"n":3,"t":"وَاليْلِ إِذَا يَغْشَيٰهَا"},{"n":4,"t":"وَالسَّمَآءِ وَمَا بَنَيٰهَا"},{"n":5,"t":"وَالَارْضِ وَمَا طَحَيٰهَا"},{"n":6,"t":"وَنَفْسٖ وَمَا سَوَّيٰهَا"},{"n":7,"t":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَيٰهَا"},{"n":8,"t":"قَدَ اَفْلَحَ مَن زَكَّيٰهَا"},{"n":9,"t":"وَقَدْ خَابَ مَن دَسَّيٰهَاۖ"},{"n":10,"t":"كَذَّبَتْ ثَمُودُ بِطَغْوَيٰهَآ"},{"n":11,"t":"إِذِ اِ۪نۢبَعَثَ أَشْقَيٰهَا"},{"n":12,"t":"فَقَالَ لَهُمْ رَسُولُ اُ۬للَّهِ نَاقَةَ اَ۬للَّهِ وَسُقْيَاهَا"},{"n":13,"t":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّيٰهَاۖ"},{"n":14,"t":"فَلَا يَخَافُ عُقْبَٰهَاۖ"},{"n":15,"t":"لا تنسنا من دعوة صالحة بظهر الغيب"}]}
{"n":99,"name":"الزلزلة","type":"مدنية","count":8,"page":599,"verses":[{"n":1,"t":"وَأَخْرَجَتِ اِ۬لَارْضُ أَثْقَالَهَا"},{"n":2,"t":"وَقَالَ اَ۬لِانسَٰنُ مَا لَهَا"},{"n":3,"t":"يَوْمَئِذٖ تُحَدِّثُ أَخْبَارَهَا"},{"n":4,"t":"بِأَنَّ رَبَّكَ أَوْح۪يٰ لَهَاۖ"},{"n":5,"t":"يَوْمَئِذٖ يَصْدُرُ اُ۬لنَّاسُ أَشْتَاتاٗ"},{"n":6,"t":"لِّيُرَوَاْ اَعْمَٰلَهُمْۖ"},{"n":7,"t":"فَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْراٗ يَرَهُۥۖ"},{"n":8,"t":"وَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٖ شَرّاٗ يَرَهُۥۖ"},{"n":9,"t":"لا تنسنا من دعوة صالحة بظهر الغيب"}]}
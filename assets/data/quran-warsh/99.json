{"n":99,"name":"الزلزلة","type":"مدنية","count":8,"page":599,"verses":[{"n":1,"t":"إِذَا زُلْزِلَتِ اِ۬لَارْضُ زِلْزَالَهَا"},{"n":2,"t":"وَأَخْرَجَتِ اِ۬لَارْضُ أَثْقَالَهَا"},{"n":3,"t":"وَقَالَ اَ۬لِانسَٰنُ مَا لَهَا"},{"n":4,"t":"يَوْمَئِذٖ تُحَدِّثُ أَخْبَارَهَا"},{"n":5,"t":"بِأَنَّ رَبَّكَ أَوْح۪يٰ لَهَاۖ"},{"n":6,"t":"يَوْمَئِذٖ يَصْدُرُ اُ۬لنَّاسُ أَشْتَاتاٗ"},{"n":7,"t":"لِّيُرَوَاْ اَعْمَٰلَهُمْۖ"},{"n":8,"t":"فَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْراٗ يَرَهُۥۖ"},{"n":9,"t":"وَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٖ شَرّاٗ يَرَهُۥۖ"}]}
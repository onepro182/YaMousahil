{"n":93,"name":"الضحى","type":"مكية","count":11,"page":596,"verses":[{"n":1,"t":"وَاليْلِ إِذَا سَج۪يٰ"},{"n":2,"t":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَل۪يٰۖ"},{"n":3,"t":"وَلَلَاخِرَةُ خَيْرٞ لَّكَ مِنَ اَ۬لُاول۪يٰۖ"},{"n":4,"t":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْض۪يٰٓۖ"},{"n":5,"t":"أَلَمْ يَجِدْكَ يَتِيماٗ فَـَٔاو۪يٰ"},{"n":6,"t":"وَوَجَدَكَ ضَآلّاٗ فَهَد۪يٰ"},{"n":7,"t":"وَوَجَدَكَ عَآئِلاٗ فَأَغْن۪يٰۖ"},{"n":8,"t":"فَأَمَّا اَ۬لْيَتِيمَ فَلَا تَقْهَرْۖ"},{"n":9,"t":"وَأَمَّا اَ۬لسَّآئِلَ فَلَا تَنْهَرْۖ"},{"n":10,"t":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثَۖ"},{"n":11,"t":"لا تنسنا من دعوة صالحة بظهر الغيب"}]}
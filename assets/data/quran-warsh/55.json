{"n":55,"name":"الرحمن","type":"مدنية","count":78,"page":531,"verses":[{"n":1,"t":"خَلَقَ اَ۬لِانسَٰنَ عَلَّمَهُ اُ۬لْبَيَانَۖ"},{"n":2,"t":"اَ۬لشَّمْسُ وَالْقَمَرُ بِحُسْبَانٖۖ"},{"n":3,"t":"وَالنَّجْمُ وَالشَّجَرُ يَسْجُدَٰنِۖ"},{"n":4,"t":"وَالسَّمَآءَ رَفَعَهَا وَوَضَعَ اَ۬لْمِيزَانَ"},{"n":5,"t":"أَلَّا تَطْغَوْاْ فِے اِ۬لْمِيزَانِ"},{"n":6,"t":"وَأَقِيمُواْ اُ۬لْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُواْ اُ۬لْمِيزَانَۖ"},{"n":7,"t":"وَالَارْضَ وَضَعَهَا لِلَانَامِ"},{"n":8,"t":"فِيهَا فَٰكِهَةٞ وَالنَّخْلُ ذَاتُ اُ۬لَاكْمَامِ"},{"n":9,"t":"وَالْحَبُّ ذُو اُ۬لْعَصْفِ وَالرَّيْحَانُۖ"},{"n":10,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":11,"t":"خَلَقَ اَ۬لِانسَٰنَ مِن صَلْصَٰلٖ كَالْفَخّ۪ارِ"},{"n":12,"t":"وَخَلَقَ اَ۬لْجَآنَّ مِن مَّارِجٖ مِّن نّ۪ارٖۖ"},{"n":13,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"n":14,"t":"رَبُّ اُ۬لْمَشْرِقَيْنِ وَرَبُّ اُ۬لْمَغْرِبَيْنِۖ"},{"n":15,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":16,"t":"مَرَجَ اَ۬لْبَحْرَيْنِ يَلْتَقِيَٰنِ"},{"n":17,"t":"بَيْنَهُمَا بَرْزَخٞ لَّا يَبْغِيَٰنِۖ"},{"n":18,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":19,"t":"يُخْرَجُ مِنْهُمَا اَ۬للُّؤْلُؤُاْ وَالْمَرْجَانُۖ"},{"n":20,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":21,"t":"وَلَهُ اُ۬لْجَوَارِ اِ۬لْمُنشَأَٰتُ فِے اِ۬لْبَحْرِ كَالَاعْلَٰمِۖ"},{"n":22,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":23,"t":"كُلُّ مَنْ عَلَيْهَا فَانٖ"},{"n":24,"t":"وَيَبْق۪يٰ وَجْهُ رَبِّكَ ذُو اُ۬لْجَلَٰلِ وَالِاكْرَامِۖ"},{"n":25,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":26,"t":"يَسْـَٔلُهُۥ مَن فِے اِ۬لسَّمَٰوَٰتِ وَالَارْضِۖ كُلَّ يَوْمٍ هُوَ فِے شَأْنٖۖ"},{"n":27,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":28,"t":"سَنَفْرُغُ لَكُمُۥٓ أَيُّهَ اَ۬لثَّقَلَٰنِۖ"},{"n":29,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":30,"t":"يَٰمَعْشَرَ اَ۬لْجِنِّ وَالِانسِ إِنِ اِ۪سْتَطَعْتُمُۥٓ أَن تَنفُذُواْ مِنَ اَقْط۪ارِ اِ۬لسَّمَٰوَٰتِ وَالَارْضِ فَانفُذُواْۖ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٖۖ"},{"n":31,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":32,"t":"يُرْسَلُ عَلَيْكُمَا شُوَاظٞ مِّن نّ۪ارٖ"},{"n":33,"t":"وَنُحَاسٞ فَلَا تَنتَصِرَٰنِۖ"},{"n":34,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":35,"t":"فَإِذَا اَ۪نشَقَّتِ اِ۬لسَّمَآءُ فَكَانَتْ وَرْدَةٗ كَالدِّهَانِ"},{"n":36,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"n":37,"t":"فَيَوْمَئِذٖ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٞ وَلَا جَآنّٞۖ"},{"n":38,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":39,"t":"۞يُعْرَفُ اُ۬لْمُجْرِمُونَ بِسِيمٰ۪هُمْ فَيُوخَذُ بِالنَّوَٰصِے وَالَاقْدَامِۖ"},{"n":40,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":41,"t":"هَٰذِهِۦ جَهَنَّمُ اُ۬لتِے يُكَذِّبُ بِهَا اَ۬لْمُجْرِمُونَ"},{"n":42,"t":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ اٰنٖۖ"},{"n":43,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":44,"t":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَٰنِ"},{"n":45,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"n":46,"t":"ذَوَاتَآ أَفْنَانٖۖ"},{"n":47,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":48,"t":"فِيهِمَا عَيْنَٰنِ تَجْرِيَٰنِۖ"},{"n":49,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":50,"t":"فِيهِمَا مِن كُلِّ فَٰكِهَةٖ زَوْجَٰنِۖ"},{"n":51,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":52,"t":"مُتَّكِـِٕينَ عَلَيٰ فُرُشِۢ بَطَآئِنُهَا مِنِ اِسْتَبْرَقٖ وَجَنَا اَ۬لْجَنَّتَيْنِ دَانٖۖ"},{"n":53,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":54,"t":"فِيهِنَّ قَٰصِرَٰتُ اُ۬لطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٞ قَبْلَهُمْ وَلَا جَآنّٞۖ"},{"n":55,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":56,"t":"كَأَنَّهُنَّ اَ۬لْيَاقُوتُ وَالْمَرْجَانُۖ"},{"n":57,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":58,"t":"هَلْ جَزَآءُ اُ۬لِاحْسَٰنِ إِلَّا اَ۬لِاحْسَٰنُۖ"},{"n":59,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":60,"t":"وَمِن دُونِهِمَا جَنَّتَٰنِ"},{"n":61,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"n":62,"t":"مُدْهَآمَّتَٰنِۖ"},{"n":63,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":64,"t":"فِيهِمَا عَيْنَٰنِ نَضَّاخَتَٰنِۖ"},{"n":65,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":66,"t":"فِيهِمَا فَٰكِهَةٞ وَنَخْلٞ وَرُمَّانٞۖ"},{"n":67,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":68,"t":"فِيهِنَّ خَيْرَٰتٌ حِسَانٞۖ"},{"n":69,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":70,"t":"حُورٞ مَّقْصُورَٰتٞ فِے اِ۬لْخِيَامِۖ"},{"n":71,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":72,"t":"لَمْ يَطْمِثْهُنَّ إِنسٞ قَبْلَهُمْ وَلَا جَآنّٞۖ"},{"n":73,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":74,"t":"مُتَّكِـِٕينَ عَلَيٰ رَفْرَفٍ خُضْرٖ وَعَبْقَرِيٍّ حِسَانٖۖ"},{"n":75,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":76,"t":"تَبَٰرَكَ اَ۪سْمُ رَبِّكَ ذِے اِ۬لْجَلَٰلِ وَالِاكْرَامِۖ"},{"n":77,"t":"لا تنسنا من دعوة صالحة بظهر الغيب"}]}
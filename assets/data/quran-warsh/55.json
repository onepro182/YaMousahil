{"n":55,"name":"الرحمن","type":"مدنية","count":78,"page":531,"verses":[{"n":1,"t":"اِ۬لرَّحْمَٰنُ عَلَّمَ اَ۬لْقُرْءَانَۖ"},{"n":2,"t":"خَلَقَ اَ۬لِانسَٰنَ عَلَّمَهُ اُ۬لْبَيَانَۖ"},{"n":3,"t":"اَ۬لشَّمْسُ وَالْقَمَرُ بِحُسْبَانٖۖ"},{"n":4,"t":"وَالنَّجْمُ وَالشَّجَرُ يَسْجُدَٰنِۖ"},{"n":5,"t":"وَالسَّمَآءَ رَفَعَهَا وَوَضَعَ اَ۬لْمِيزَانَ"},{"n":6,"t":"أَلَّا تَطْغَوْاْ فِے اِ۬لْمِيزَانِ"},{"n":7,"t":"وَأَقِيمُواْ اُ۬لْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُواْ اُ۬لْمِيزَانَۖ"},{"n":8,"t":"وَالَارْضَ وَضَعَهَا لِلَانَامِ"},{"n":9,"t":"فِيهَا فَٰكِهَةٞ وَالنَّخْلُ ذَاتُ اُ۬لَاكْمَامِ"},{"n":10,"t":"وَالْحَبُّ ذُو اُ۬لْعَصْفِ وَالرَّيْحَانُۖ"},{"n":11,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":12,"t":"خَلَقَ اَ۬لِانسَٰنَ مِن صَلْصَٰلٖ كَالْفَخّ۪ارِ"},{"n":13,"t":"وَخَلَقَ اَ۬لْجَآنَّ مِن مَّارِجٖ مِّن نّ۪ارٖۖ"},{"n":14,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"n":15,"t":"رَبُّ اُ۬لْمَشْرِقَيْنِ وَرَبُّ اُ۬لْمَغْرِبَيْنِۖ"},{"n":16,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":17,"t":"مَرَجَ اَ۬لْبَحْرَيْنِ يَلْتَقِيَٰنِ"},{"n":18,"t":"بَيْنَهُمَا بَرْزَخٞ لَّا يَبْغِيَٰنِۖ"},{"n":19,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":20,"t":"يُخْرَجُ مِنْهُمَا اَ۬للُّؤْلُؤُاْ وَالْمَرْجَانُۖ"},{"n":21,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":22,"t":"وَلَهُ اُ۬لْجَوَارِ اِ۬لْمُنشَأَٰتُ فِے اِ۬لْبَحْرِ كَالَاعْلَٰمِۖ"},{"n":23,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":24,"t":"كُلُّ مَنْ عَلَيْهَا فَانٖ"},{"n":25,"t":"وَيَبْق۪يٰ وَجْهُ رَبِّكَ ذُو اُ۬لْجَلَٰلِ وَالِاكْرَامِۖ"},{"n":26,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":27,"t":"يَسْـَٔلُهُۥ مَن فِے اِ۬لسَّمَٰوَٰتِ وَالَارْضِۖ كُلَّ يَوْمٍ هُوَ فِے شَأْنٖۖ"},{"n":28,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":29,"t":"سَنَفْرُغُ لَكُمُۥٓ أَيُّهَ اَ۬لثَّقَلَٰنِۖ"},{"n":30,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"n":31,"t":"يَٰمَعْشَرَ اَ۬لْجِنِّ وَالِانسِ إِنِ اِ۪سْتَطَعْتُمُۥٓ أَن تَنفُذُواْ مِنَ اَقْط۪ارِ اِ
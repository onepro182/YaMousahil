{"n":89,"name":"الفجر","type":"مكية","count":30,"page":593,"verses":[{"n":1,"t":"وَلَيَالٍ عَشْرٖ"},{"n":2,"t":"وَالشَّفْعِ وَالْوَتْرِ"},{"n":3,"t":"وَاليْلِ إِذَا يَسْرِۦ"},{"n":4,"t":"هَلْ فِے ذَٰلِكَ قَسَمٞ لِّذِے حِجْرٍۖ"},{"n":5,"t":"اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ"},{"n":6,"t":"اِرَمَ ذَاتِ اِ۬لْعِمَادِ"},{"n":7,"t":"اِ۬لتِے لَمْ يُخْلَقْ مِثْلُهَا فِے اِ۬لْبِلَٰدِ"},{"n":8,"t":"وَثَمُودَ اَ۬لذِينَ جَابُواْ اُ۬لصَّخْرَ بِالْوَادِۦ"},{"n":9,"t":"وَفِرْعَوْنَ ذِے اِ۬لَاوْتَادِ"},{"n":10,"t":"اِ۬لذِينَ طَغَوْاْ فِے اِ۬لْبِلَٰدِ"},{"n":11,"t":"فَأَكْثَرُواْ فِيهَا اَ۬لْفَسَادَ"},{"n":12,"t":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍۖ"},{"n":13,"t":"اِنَّ رَبَّكَ لَبِالْمِرْصَادِۖ"},{"n":14,"t":"فَأَمَّا اَ۬لِانسَٰنُ إِذَا مَا اَ۪بْتَل۪يٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ"},{"n":15,"t":"فَيَقُولُ رَبِّيَ أَكْرَمَنِۦۖ"},{"n":16,"t":"وَأَمَّآ إِذَا مَا اَ۪بْتَل۪يٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ"},{"n":17,"t":"فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ"},{"n":18,"t":"كَلَّاۖ بَل لَّا تُكْرِمُونَ اَ۬لْيَتِيمَ"},{"n":19,"t":"وَلَا تَحُضُّونَ عَلَيٰ طَعَامِ اِ۬لْمِسْكِينِ"},{"n":20,"t":"وَتَاكُلُونَ اَ۬لتُّرَاثَ أَكْلاٗ لَّمّاٗ"},{"n":21,"t":"وَتُحِبُّونَ اَ۬لْمَالَ حُبّاٗ جَمّاٗ"},{"n":22,"t":"كَلَّآ إِذَا دُكَّتِ اِ۬لَارْضُ دَكّاٗ دَكّاٗ"},{"n":23,"t":"وَجَآءَ رَبُّكَ وَالْمَلَكُ صَفّاٗ صَفّاٗ"},{"n":24,"t":"وَجِےٓءَ يَوْمَئِذِۢ بِجَهَنَّمَ"},{"n":25,"t":"يَوْمَئِذٖ يَتَذَكَّرُ اُ۬لِانسَٰنُ وَأَنّ۪يٰ لَهُ اُ۬لذِّكْر۪يٰۖ"},{"n":26,"t":"يَقُولُ يَٰلَيْتَنِے قَدَّمْتُ لِحَيَاتِےۖ"},{"n":27,"t":"فَيَوْمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ"},{"n":28,"t":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞۖ"},{"n":29,"t":"يَٰٓأَيَّتُهَا اَ۬لنَّفْسُ اُ۬لْمُطْمَئِنَّةُ"},{"n":30,"t":"اُ۪رْجِعِےٓ إِلَيٰ رَبِّكِ رَاضِيَةٗ مَّرْضِيَّةٗ"},{"n":31,"t":"فَادْخُلِے فِے عِبَٰدِے وَادْخُلِے جَنَّتِےۖ"},{"n":32,"t":"لا تنسنا من دعوة صالحة بظهر الغيب"}]}
{"n":89,"name":"الفجر","type":"مكية","count":30,"page":593,"verses":[{"n":1,"t":"وَالْفَجْرِ"},{"n":2,"t":"وَلَيَالٍ عَشْرٖ"},{"n":3,"t":"وَالشَّفْعِ وَالْوَتْرِ"},{"n":4,"t":"وَاليْلِ إِذَا يَسْرِۦ"},{"n":5,"t":"هَلْ فِے ذَٰلِكَ قَسَمٞ لِّذِے حِجْرٍۖ"},{"n":6,"t":"اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ"},{"n":7,"t":"اِرَمَ ذَاتِ اِ۬لْعِمَادِ"},{"n":8,"t":"اِ۬لتِے لَمْ يُخْلَقْ مِثْلُهَا فِے اِ۬لْبِلَٰدِ"},{"n":9,"t":"وَثَمُودَ اَ۬لذِينَ جَابُواْ اُ۬لصَّخْرَ بِالْوَادِۦ"},{"n":10,"t":"وَفِرْعَوْنَ ذِے اِ۬لَاوْتَادِ"},{"n":11,"t":"اِ۬لذِينَ طَغَوْاْ فِے اِ۬لْبِلَٰدِ"},{"n":12,"t":"فَأَكْثَرُواْ فِيهَا اَ۬لْفَسَادَ"},{"n":13,"t":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍۖ"},{"n":14,"t":"اِنَّ رَبَّكَ لَبِالْمِرْصَادِۖ"},{"n":15,"t":"فَأَمَّا اَ۬لِانسَٰنُ إِذَا مَا اَ۪بْتَل۪يٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ"},{"n":16,"t":"فَيَقُولُ رَبِّيَ أَكْرَمَنِۦۖ"},{"n":17,"t":"وَأَمَّآ إِذَا مَا اَ۪بْتَل۪يٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ"},{"n":18,"t":"فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ"},{"n":19,"t":"كَلَّاۖ بَل لَّا تُكْرِمُونَ اَ۬لْيَتِيمَ"},{"n":20,"t":"وَلَا تَحُضُّونَ عَلَيٰ طَعَامِ اِ۬لْمِسْكِينِ"},{"n":21,"t":"وَتَاكُلُونَ اَ۬لتُّرَاثَ أَكْلاٗ لَّمّاٗ"},{"n":22,"t":"وَتُحِبُّونَ اَ۬لْمَالَ حُبّاٗ جَمّاٗ"},{"n":23,"t":"كَلَّآ إِذَا دُكَّتِ اِ۬لَارْضُ دَكّاٗ دَكّاٗ"},{"n":24,"t":"وَجَآءَ رَبُّكَ وَالْمَلَكُ صَفّاٗ صَفّاٗ"},{"n":25,"t":"وَجِےٓءَ يَوْمَئِذِۢ بِجَهَنَّمَ"},{"n":26,"t":"يَوْمَئِذٖ يَتَذَكَّرُ اُ۬لِانسَٰنُ وَأَنّ۪يٰ لَهُ اُ۬لذِّكْر۪يٰۖ"},{"n":27,"t":"يَقُولُ يَٰلَيْتَنِے قَدَّمْتُ لِحَيَاتِےۖ"},{"n":28,"t":"فَيَوْمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ"},{"n":29,"t":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞۖ"},{"n":30,"t":"يَٰٓأَيَّتُهَا اَ۬لنَّفْسُ اُ۬لْمُطْمَئِنَّةُ"},{"n":31,"t":"اُ۪رْجِعِےٓ إِلَيٰ رَبِّكِ رَاضِيَةٗ مَّرْضِيَّةٗ"},{"n":32,"t":"فَادْخُلِے فِے عِبَٰدِے وَادْخُلِے جَنَّتِےۖ"}]}
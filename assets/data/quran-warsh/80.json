{"n":80,"name":"عبس","type":"مكية","count":42,"page":585,"verses":[{"n":1,"t":"أَن جَآءَهُ اُ۬لَاعْم۪يٰۖ"},{"n":2,"t":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكّ۪يٰٓ"},{"n":3,"t":"أَوْ يَذَّكَّرُ فَتَنفَعُهُ اُ۬لذِّكْر۪يٰٓۖ"},{"n":4,"t":"أَمَّا مَنِ اِ۪سْتَغْن۪يٰ"},{"n":5,"t":"فَأَنتَ لَهُۥ تَصَّدّ۪يٰ"},{"n":6,"t":"وَمَا عَلَيْكَ أَلَّا يَزَّكّ۪يٰۖ"},{"n":7,"t":"وَأَمَّا مَن جَآءَكَ يَسْع۪يٰ"},{"n":8,"t":"وَهُوَ يَخْش۪يٰ"},{"n":9,"t":"فَأَنتَ عَنْهُ تَلَهّ۪يٰ"},{"n":10,"t":"كَلَّآ إِنَّهَا تَذْكِرَةٞۖ"},{"n":11,"t":"فَمَن شَآءَ ذَكَرَهُۥ"},{"n":12,"t":"فِے صُحُفٖ مُّكَرَّمَةٖ"},{"n":13,"t":"مَّرْفُوعَةٖ مُّطَهَّرَةِۢ"},{"n":14,"t":"بِأَيْدِے سَفَرَةٖ"},{"n":15,"t":"كِرَامِۢ بَرَرَةٖۖ"},{"n":16,"t":"قُتِلَ اَ۬لِانسَٰنُ مَآ أَكْفَرَهُۥۖ"},{"n":17,"t":"مِنَ اَيِّ شَےْءٍ خَلَقَهُۥۖ"},{"n":18,"t":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"},{"n":19,"t":"ثُمَّ اَ۬لسَّبِيلَ يَسَّرَهُۥ"},{"n":20,"t":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥۖ"},{"n":21,"t":"ثُمَّ إِذَا شَآءَ انشَرَهُۥۖ"},{"n":22,"t":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥۖ"},{"n":23,"t":"فَلْيَنظُرِ اِ۬لِانسَٰنُ إِلَيٰ طَعَامِهِۦٓۖ"},{"n":24,"t":"إِنَّا صَبَبْنَا اَ۬لْمَآءَ صَبّاٗ"},{"n":25,"t":"ثُمَّ شَقَقْنَا اَ۬لَارْضَ شَقّاٗ"},{"n":26,"t":"فَأَنۢبَتْنَا فِيهَا حَبّاٗ"},{"n":27,"t":"وَعِنَباٗ وَقَضْباٗ"},{"n":28,"t":"وَزَيْتُوناٗ وَنَخْلاٗ"},{"n":29,"t":"وَحَدَآئِقَ غُلْباٗ"},{"n":30,"t":"وَفَٰكِهَةٗ وَأَبّاٗ"},{"n":31,"t":"مَّتَٰعاٗ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ"},{"n":32,"t":"فَإِذَا جَآءَتِ اِ۬لصَّآخَّةُ"},{"n":33,"t":"يَوْمَ يَفِرُّ اُ۬لْمَرْءُ مِنَ اَخِيهِ"},{"n":34,"t":"وَأُمِّهِۦ وَأَبِيهِ"},{"n":35,"t":"وَصَٰحِبَتِهِۦ وَبَنِيهِۖ"},{"n":36,"t":"لِكُلِّ اِ۪مْرِےٕٖ مِّنْهُمْ يَوْمَئِذٖ شَأْنٞ يُغْنِيهِۖ"},{"n":37,"t":"وُجُوهٞ يَوْمَئِذٖ مُّسْفِرَةٞ"},{"n":38,"t":"ضَاحِكَةٞ مُّسْتَبْشِرَةٞۖ"},{"n":39,"t":"وَوُجُوهٞ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٞ"},{"n":40,"t":"تَرْهَقُهَا قَتَرَةٌۖ"},{"n":41,"t":"ا۟وْلَٰٓئِكَ هُمُ اُ۬لْكَفَرَةُ اُ۬لْفَجَرَةُۖ"},{"n":42,"t":"لا تنسنا من دعوة صالحة بظهر الغيب"}]}
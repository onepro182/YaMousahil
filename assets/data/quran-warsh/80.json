{"n":80,"name":"عبس","type":"مكية","count":42,"page":585,"verses":[{"n":1,"t":"عَبَسَ وَتَوَلّ۪يٰٓ"},{"n":2,"t":"أَن جَآءَهُ اُ۬لَاعْم۪يٰۖ"},{"n":3,"t":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكّ۪يٰٓ"},{"n":4,"t":"أَوْ يَذَّكَّرُ فَتَنفَعُهُ اُ۬لذِّكْر۪يٰٓۖ"},{"n":5,"t":"أَمَّا مَنِ اِ۪سْتَغْن۪يٰ"},{"n":6,"t":"فَأَنتَ لَهُۥ تَصَّدّ۪يٰ"},{"n":7,"t":"وَمَا عَلَيْكَ أَلَّا يَزَّكّ۪يٰۖ"},{"n":8,"t":"وَأَمَّا مَن جَآءَكَ يَسْع۪يٰ"},{"n":9,"t":"وَهُوَ يَخْش۪يٰ"},{"n":10,"t":"فَأَنتَ عَنْهُ تَلَهّ۪يٰ"},{"n":11,"t":"كَلَّآ إِنَّهَا تَذْكِرَةٞۖ"},{"n":12,"t":"فَمَن شَآءَ ذَكَرَهُۥ"},{"n":13,"t":"فِے صُحُفٖ مُّكَرَّمَةٖ"},{"n":14,"t":"مَّرْفُوعَةٖ مُّطَهَّرَةِۢ"},{"n":15,"t":"بِأَيْدِے سَفَرَةٖ"},{"n":16,"t":"كِرَامِۢ بَرَرَةٖۖ"},{"n":17,"t":"قُتِلَ اَ۬لِانسَٰنُ مَآ أَكْفَرَهُۥۖ"},{"n":18,"t":"مِنَ اَيِّ شَےْءٍ خَلَقَهُۥۖ"},{"n":19,"t":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"},{"n":20,"t":"ثُمَّ اَ۬لسَّبِيلَ يَسَّرَهُۥ"},{"n":21,"t":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥۖ"},{"n":22,"t":"ثُمَّ إِذَا شَآءَ انشَرَهُۥۖ"},{"n":23,"t":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥۖ"},{"n":24,"t":"فَلْيَنظُرِ اِ۬لِانسَٰنُ إِلَيٰ طَعَامِهِۦٓۖ"},{"n":25,"t":"إِنَّا صَبَبْنَا اَ۬لْمَآءَ صَبّاٗ"},{"n":26,"t":"ثُمَّ شَقَقْنَا اَ۬لَارْضَ شَقّاٗ"},{"n":27,"t":"فَأَنۢبَتْنَا فِيهَا حَبّاٗ"},{"n":28,"t":"وَعِنَباٗ وَقَضْباٗ"},{"n":29,"t":"وَزَيْتُوناٗ وَنَخْلاٗ"},{"n":30,"t":"وَحَدَآئِقَ غُلْباٗ"},{"n":31,"t":"وَفَٰكِهَةٗ وَأَبّاٗ"},{"n":32,"t":"مَّتَٰعاٗ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ"},{"n":33,"t":"فَإِذَا جَآءَتِ اِ۬لصَّآخَّةُ"},{"n":34,"t":"يَوْمَ يَفِرُّ اُ۬لْمَرْءُ مِنَ اَخِيهِ"},{"n":35,"t":"وَأُمِّهِۦ وَأَبِيهِ"},{"n":36,"t":"وَصَٰحِبَتِهِۦ وَبَنِيهِۖ"},{"n":37,"t":"لِكُلِّ اِ۪مْرِےٕٖ مِّنْهُمْ يَوْمَئِذٖ شَأْنٞ يُغْنِيهِۖ"},{"n":38,"t":"وُجُوهٞ يَوْمَئِذٖ مُّسْفِرَةٞ"},{"n":39,"t":"ضَاحِكَةٞ مُّسْتَبْشِرَةٞۖ"},{"n":40,"t":"وَوُجُوهٞ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٞ"},{"n":41,"t":"تَرْهَقُهَا قَتَرَةٌۖ"},{"n":42,"t":"ا۟وْلَٰٓئِكَ هُمُ اُ۬لْكَفَرَةُ اُ۬لْفَجَرَةُۖ"}]}
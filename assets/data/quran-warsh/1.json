{"n":1,"name":"الفاتحة","type":"مكية","count":7,"page":1,"verses":[{"n":1,"t":"اِ۬لْحَمْدُ لِلهِ رَبِّ اِ۬لْعَٰلَمِينَ"},{"n":2,"t":"اَ۬لرَّحْمَٰنِ اِ۬لرَّحِيمِ"},{"n":3,"t":"مَلِكِ يَوْمِ اِ۬لدِّينِۖ"},{"n":4,"t":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُۖ"},{"n":5,"t":"اُ۪هْدِنَا اَ۬لصِّرَٰطَ اَ۬لْمُسْتَقِيمَ"},{"n":6,"t":"صِرَٰطَ اَ۬لذِينَ أَنْعَمْتَ عَلَيْهِمْ"},{"n":7,"t":"غَيْرِ اِ۬لْمَغْضُوبِ عَلَيْهِمْ وَلَا اَ۬لضَّآلِّينَۖ"}]}
{"n":104,"name":"الهمزة","type":"مكية","count":9,"page":601,"verses":[{"n":1,"t":"وَيْلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ"},{"n":2,"t":"اِ۬لذِے جَمَعَ مَالاٗ وَعَدَّدَهُۥ"},{"n":3,"t":"يَحْسِبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ"},{"n":4,"t":"كَلَّاۖ لَيُنۢبَذَنَّ فِے اِ۬لْحُطَمَةِۖ"},{"n":5,"t":"وَمَآ أَدْر۪يٰكَ مَا اَ۬لْحُطَمَةُۖ"},{"n":6,"t":"نَارُ اُ۬للَّهِ اِ۬لْمُوقَدَةُ"},{"n":7,"t":"اُ۬لتِے تَطَّلِعُ عَلَي اَ۬لَافْـِٕدَةِۖ"},{"n":8,"t":"إِنَّهَا عَلَيْهِم مُّوصَدَةٞ"},{"n":9,"t":"فِے عَمَدٖ مُّمَدَّدَةٍۖ"}]}
{"n":104,"name":"الهمزة","type":"مكية","count":9,"page":601,"verses":[{"n":1,"t":"اِ۬لذِے جَمَعَ مَالاٗ وَعَدَّدَهُۥ"},{"n":2,"t":"يَحْسِبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ"},{"n":3,"t":"كَلَّاۖ لَيُنۢبَذَنَّ فِے اِ۬لْحُطَمَةِۖ"},{"n":4,"t":"وَمَآ أَدْر۪يٰكَ مَا اَ۬لْحُطَمَةُۖ"},{"n":5,"t":"نَارُ اُ۬للَّهِ اِ۬لْمُوقَدَةُ"},{"n":6,"t":"اُ۬لتِے تَطَّلِعُ عَلَي اَ۬لَافْـِٕدَةِۖ"},{"n":7,"t":"إِنَّهَا عَلَيْهِم مُّوصَدَةٞ"},{"n":8,"t":"فِے عَمَدٖ مُّمَدَّدَةٍۖ"},{"n":9,"t":"لا تنسنا من دعوة صالحة بظهر الغيب"}]}
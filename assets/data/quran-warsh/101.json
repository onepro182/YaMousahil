{"n":101,"name":"القارعة","type":"مكية","count":11,"page":600,"verses":[{"n":1,"t":"اِ۬لْقَارِعَةُ مَا اَ۬لْقَارِعَةُۖ"},{"n":2,"t":"وَمَآ أَدْر۪يٰكَ مَا اَ۬لْقَارِعَةُۖ"},{"n":3,"t":"يَوْمَ يَكُونُ اُ۬لنَّاسُ كَالْفَرَاشِ اِ۬لْمَبْثُوثِ"},{"n":4,"t":"وَتَكُونُ اُ۬لْجِبَالُ كَالْعِهْنِ اِ۬لْمَنفُوشِۖ"},{"n":5,"t":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ"},{"n":6,"t":"فَهُوَ فِے عِيشَةٖ رَّاضِيَةٖۖ"},{"n":7,"t":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ"},{"n":8,"t":"فَأُمُّهُۥ هَاوِيَةٞۖ"},{"n":9,"t":"وَمَآ أَدْر۪يٰكَ مَا هِيَهْۖ"},{"n":10,"t":"نَارٌ حَامِيَةٌۖ"}]}
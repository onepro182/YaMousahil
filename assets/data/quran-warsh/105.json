{"n":105,"name":"الفيل","type":"مكية","count":5,"page":601,"verses":[{"n":1,"t":"اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ اِ۬لْفِيلِۖ"},{"n":2,"t":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِے تَضْلِيلٖ"},{"n":3,"t":"وَأَرْسَلَ عَلَيْهِمْ طَيْراً اَبَابِيلَ"},{"n":4,"t":"تَرْمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ"},{"n":5,"t":"فَجَعَلَهُمْ كَعَصْفٖ مَّاكُولٖۖ"}]}
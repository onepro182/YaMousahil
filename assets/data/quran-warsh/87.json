{"n":87,"name":"الأعلى","type":"مكية","count":19,"page":591,"verses":[{"n":1,"t":"اَ۬لذِے خَلَقَ فَسَوّ۪يٰ"},{"n":2,"t":"وَالذِے قَدَّرَ فَهَد۪يٰ"},{"n":3,"t":"وَالذِےٓ أَخْرَجَ اَ۬لْمَرْع۪يٰ"},{"n":4,"t":"فَجَعَلَهُۥ غُثَآءً اَحْو۪يٰۖ"},{"n":5,"t":"سَنُقْرِئُكَ فَلَا تَنس۪يٰٓ"},{"n":6,"t":"إِلَّا مَا شَآءَ اَ۬للَّهُۖ إِنَّهُۥ يَعْلَمُ اُ۬لْجَهْرَ وَمَا يَخْف۪يٰۖ"},{"n":7,"t":"وَنُيَسِّرُكَ لِلْيُسْر۪يٰۖ"},{"n":8,"t":"فَذَكِّرِ اِن نَّفَعَتِ اِ۬لذِّكْر۪يٰۖ"},{"n":9,"t":"سَيَذَّكَّرُ مَنْ يَّخْش۪يٰ"},{"n":10,"t":"وَيَتَجَنَّبُهَا اَ۬لَاشْقَي"},{"n":11,"t":"اَ۬لذِے يَصْلَي اَ۬لنَّارَ اَ۬لْكُبْر۪يٰ"},{"n":12,"t":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْي۪يٰۖ"},{"n":13,"t":"قَدَ اَفْلَحَ مَن تَزَكّ۪يٰ"},{"n":14,"t":"وَذَكَرَ اَ۪سْمَ رَبِّهِۦ فَصَلّ۪يٰۖ"},{"n":15,"t":"بَلْ تُوثِرُونَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْي۪ا"},{"n":16,"t":"وَالَاخِرَةُ خَيْرٞ وَأَبْق۪يٰٓۖ"},{"n":17,"t":"إِنَّ هَٰذَا لَفِے اِ۬لصُّحُفِ اِ۬لُاول۪يٰ"},{"n":18,"t":"صُحُفِ إِبْرَٰهِيمَ وَمُوس۪يٰۖ"},{"n":19,"t":"لا تنسنا من دعوة صالحة بظهر الغيب"}]}
{"n":87,"name":"الأعلى","type":"مكية","count":19,"page":591,"verses":[{"n":1,"t":"سَبِّحِ اِ۪سْمَ رَبِّكَ اَ۬لَاعْلَي"},{"n":2,"t":"اَ۬لذِے خَلَقَ فَسَوّ۪يٰ"},{"n":3,"t":"وَالذِے قَدَّرَ فَهَد۪يٰ"},{"n":4,"t":"وَالذِےٓ أَخْرَجَ اَ۬لْمَرْع۪يٰ"},{"n":5,"t":"فَجَعَلَهُۥ غُثَآءً اَحْو۪يٰۖ"},{"n":6,"t":"سَنُقْرِئُكَ فَلَا تَنس۪يٰٓ"},{"n":7,"t":"إِلَّا مَا شَآءَ اَ۬للَّهُۖ إِنَّهُۥ يَعْلَمُ اُ۬لْجَهْرَ وَمَا يَخْف۪يٰۖ"},{"n":8,"t":"وَنُيَسِّرُكَ لِلْيُسْر۪يٰۖ"},{"n":9,"t":"فَذَكِّرِ اِن نَّفَعَتِ اِ۬لذِّكْر۪يٰۖ"},{"n":10,"t":"سَيَذَّكَّرُ مَنْ يَّخْش۪يٰ"},{"n":11,"t":"وَيَتَجَنَّبُهَا اَ۬لَاشْقَي"},{"n":12,"t":"اَ۬لذِے يَصْلَي اَ۬لنَّارَ اَ۬لْكُبْر۪يٰ"},{"n":13,"t":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْي۪يٰۖ"},{"n":14,"t":"قَدَ اَفْلَحَ مَن تَزَكّ۪يٰ"},{"n":15,"t":"وَذَكَرَ اَ۪سْمَ رَبِّهِۦ فَصَلّ۪يٰۖ"},{"n":16,"t":"بَلْ تُوثِرُونَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْي۪ا"},{"n":17,"t":"وَالَاخِرَةُ خَيْرٞ وَأَبْق۪يٰٓۖ"},{"n":18,"t":"إِنَّ هَٰذَا لَفِے اِ۬لصُّحُفِ اِ۬لُاول۪يٰ"},{"n":19,"t":"صُحُفِ إِبْرَٰهِيمَ وَمُوس۪يٰۖ"}]}
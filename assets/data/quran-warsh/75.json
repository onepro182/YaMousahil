{"n":75,"name":"القيامة","type":"مكية","count":40,"page":577,"verses":[{"n":1,"t":"لَآ أُقْسِمُ بِيَوْمِ اِ۬لْقِيَٰمَةِ"},{"n":2,"t":"وَلَآ أُقْسِمُ بِالنَّفْسِ اِ۬للَّوَّامَةِۖ"},{"n":3,"t":"أَيَحْسِبُ اُ۬لِانسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ"},{"n":4,"t":"بَل۪يٰۖ قَٰدِرِينَ عَلَيٰٓ أَن نُّسَوِّيَ بَنَانَهُۥۖ"},{"n":5,"t":"بَلْ يُرِيدُ اُ۬لِانسَٰنُ لِيَفْجُرَ أَمَامَهُۥۖ"},{"n":6,"t":"يَسْـَٔلُ أَيَّانَ يَوْمُ اُ۬لْقِيَٰمَةِۖ"},{"n":7,"t":"فَإِذَا بَرَقَ اَ۬لْبَصَرُ"},{"n":8,"t":"وَخَسَفَ اَ۬لْقَمَرُ"},{"n":9,"t":"وَجُمِعَ اَ۬لشَّمْسُ وَالْقَمَرُ"},{"n":10,"t":"يَقُولُ اُ۬لِانسَٰنُ يَوْمَئِذٍ اَيْنَ اَ۬لْمَفَرُّۖ"},{"n":11,"t":"كَلَّا لَا وَزَرَۖ"},{"n":12,"t":"إِلَيٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمُسْتَقَرُّۖ"},{"n":13,"t":"يُنَبَّؤُاْ اُ۬لِانسَٰنُ يَوْمَئِذِۢ بِمَا قَدَّمَ وَأَخَّرَۖ"},{"n":14,"t":"بَلِ اِ۬لِانسَٰنُ عَلَيٰ نَفْسِهِۦ بَصِيرَةٞ"},{"n":15,"t":"وَلَوَ اَلْق۪يٰ مَعَاذِيرَهُۥۖ"},{"n":16,"t":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓۖ إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥۖ"},{"n":17,"t":"فَإِذَا قَرَأْنَٰهُ فَاتَّبِعْ قُرْءَانَهُۥ"},{"n":18,"t":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥۖ"},{"n":19,"t":"كَلَّا بَلْ تُحِبُّونَ اَ۬لْعَاجِلَةَ"},{"n":20,"t":"وَتَذَرُونَ اَ۬لَاخِرَةَۖ"},{"n":21,"t":"وُجُوهٞ يَوْمَئِذٖ نَّاضِرَةٌ"},{"n":22,"t":"اِلَيٰ رَبِّهَا نَاظِرَةٞۖ"},{"n":23,"t":"وَوُجُوهٞ يَوْمَئِذِۢ بَاسِرَةٞ"},{"n":24,"t":"تَظُنُّ أَنْ يُّفْعَلَ بِهَا فَاقِرَةٞۖ"},{"n":25,"t":"كَلَّآ إِذَا بَلَغَتِ اِ۬لتَّرَاقِيَ"},{"n":26,"t":"وَقِيلَ مَن رَّاقٖ"},{"n":27,"t":"وَظَنَّ أَنَّهُ اُ۬لْفِرَاقُ"},{"n":28,"t":"وَالْتَفَّتِ اِ۬لسَّاقُ بِالسَّاقِ"},{"n":29,"t":"إِلَيٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمَسَاقُۖ"},{"n":30,"t":"فَلَا صَدَّقَ وَلَا صَلّ۪يٰۖ"},{"n":31,"t":"وَلَٰكِن كَذَّبَ وَتَوَلّ۪يٰۖ"},{"n":32,"t":"ثُمَّ ذَهَبَ إِلَيٰٓ أَهْلِهِۦ يَتَمَطّ۪يٰٓۖ"},{"n":33,"t":"أَوْل۪يٰ لَكَ فَأَوْل۪يٰ"},{"n":34,"t":"ثُمَّ أَوْل۪يٰ لَكَ فَأَوْل۪يٰٓۖ"},{"n":35,"t":"أَيَحْسِبُ اُ۬لِانسَٰنُ أَنْ يُّتْرَكَ سُديًۖ"},{"n":36,"t":"اَلَمْ يَكُ نُطْفَةٗ مِّن مَّنِيّٖ تُمْن۪يٰ"},{"n":37,"t":"ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوّ۪يٰ"},{"n":38,"t":"فَجَعَلَ مِنْهُ اُ۬لزَّوْجَيْنِ اِ۬لذَّكَرَ وَالُانث۪يٰٓۖ"},{"n":39,"t":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَيٰٓ أَنْ يُّحْـِۧيَ اَ۬لْمَوْت۪يٰۖ"}]}
{"n":56,"name":"الواقعة","type":"مكية","count":96,"page":534,"verses":[{"n":1,"t":"إِذَا وَقَعَتِ اِ۬لْوَاقِعَةُ"},{"n":2,"t":"لَيْسَ لِوَقْعَتِهَا كَٰذِبَةٌۖ"},{"n":3,"t":"خَافِضَةٞ رَّافِعَةٌ"},{"n":4,"t":"اِذَا رُجَّتِ اِ۬لَارْضُ رَجّاٗ"},{"n":5,"t":"وَبُسَّتِ اِ۬لْجِبَالُ بَسّاٗ"},{"n":6,"t":"فَكَانَتْ هَبَآءٗ مُّنۢبَثّاٗ"},{"n":7,"t":"وَكُنتُمُۥٓ أَزْوَٰجاٗ ثَلَٰثَةٗۖ"},{"n":8,"t":"فَأَصْحَٰبُ اُ۬لْمَيْمَنَةِ"},{"n":9,"t":"مَآ أَصْحَٰبُ اُ۬لْمَيْمَنَةِۖ"},{"n":10,"t":"وَأَصْحَٰبُ اُ۬لْمَشْـَٔمَةِ"},{"n":11,"t":"مَآ أَصْحَٰبُ اُ۬لْمَشْـَٔمَةِۖ"},{"n":12,"t":"وَالسَّٰبِقُونَ اَ۬لسَّٰبِقُونَۖ"},{"n":13,"t":"أُوْلَٰٓئِكَ اَ۬لْمُقَرَّبُونَ"},{"n":14,"t":"فِے جَنَّٰتِ اِ۬لنَّعِيمِۖ"},{"n":15,"t":"ثُلَّةٞ مِّنَ اَ۬لَاوَّلِينَ"},{"n":16,"t":"وَقَلِيلٞ مِّنَ اَ۬لَاخِرِينَ"},{"n":17,"t":"عَلَيٰ سُرُرٖ مَّوْضُونَةٖ"},{"n":18,"t":"مُّتَّكِـِٕينَ عَلَيْهَا مُتَقَٰبِلِينَۖ"},{"n":19,"t":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٞ مُّخَلَّدُونَ"},{"n":20,"t":"بِأَكْوَابٖ وَأَبَارِيقَ"},{"n":21,"t":"وَكَأْسٖ مِّن مَّعِينٖ"},{"n":22,"t":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزَفُونَ"},{"n":23,"t":"وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ"},{"n":24,"t":"وَلَحْمِ طَيْرٖ مِّمَّا يَشْتَهُونَۖ"},{"n":25,"t":"وَحُورٌ عِينٞ كَأَمْثَٰلِ اِ۬للُّؤْلُوِٕ اِ۬لْمَكْنُونِ"},{"n":26,"t":"جَزَآءَۢ بِمَا كَانُواْ يَعْمَلُونَۖ"},{"n":27,"t":"لَا يَسْمَعُونَ فِيهَا لَغْواٗ وَلَا تَاثِيماًۖ"},{"n":28,"t":"اِلَّا قِيلاٗ سَلَٰماٗ سَلَٰماٗۖ"},{"n":29,"t":"وَأَصْحَٰبُ اُ۬لْيَمِينِ مَآ أَصْحَٰبُ اُ۬لْيَمِينِۖ"},{"n":30,"t":"فِے سِدْرٖ مَّخْضُودٖ"},{"n":31,"t":"وَطَلْحٖ مَّنضُودٖ"},{"n":32,"t":"وَظِلّٖ مَّمْدُودٖ"},{"n":33,"t":"وَمَآءٖ مَّسْكُوبٖ"},{"n":34,"t":"وَفَٰكِهَةٖ كَثِيرَةٖ"},{"n":35,"t":"لَّا مَقْطُوعَةٖ وَلَا مَمْنُوعَةٖ"},{"n":36,"t":"وَفُرُشٖ مَّرْفُوعَةٍۖ"},{"n":37,"t":"اِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءٗ"},{"n":38,"t":"فَجَعَلْنَٰهُنَّ أَبْكَاراً"},{"n":39,"t":"عُرُباً اَتْرَاباٗ"},{"n":40,"t":"لِّأَصْحَٰبِ اِ۬لْيَمِينِۖ"},{"n":41,"t":"ثُلَّةٞ مِّنَ اَ۬لَاوَّلِينَ"},{"n":42,"t":"وَثُلَّةٞ مِّنَ اَ۬لَاخِرِينَۖ"},{"n":43,"t":"وَأَصْحَٰبُ اُ۬لشِّمَالِ"},{"n":44,"t":"مَآ أَصْحَٰبُ اُ۬لشِّمَالِۖ"},{"n":45,"t":"فِے سَمُومٖ وَحَمِيمٖ"},{"n":46,"t":"وَظِلّٖ مِّنْ يَّحْمُومٖ"},{"n":47,"t":"لَّا بَارِدٖ وَلَا كَرِيمٍۖ"},{"n":48,"t":"اِنَّهُمْ كَانُواْ قَبْلَ ذَٰلِكَ مُتْرَفِينَۖ"},{"n":49,"t":"وَكَانُواْ يُصِرُّونَ عَلَي اَ۬لْحِنثِ اِ۬لْعَظِيمِۖ"},{"n":50,"t":"وَكَانُواْ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً اِنَّا لَمَبْعُوثُونَ"},{"n":51,"t":"أَوَءَابَآؤُنَا اَ۬لَاوَّلُونَۖ"},{"n":52,"t":"۞قُلِ اِنَّ اَ۬لَاوَّلِينَ وَالَاخِرِينَ لَمَجْمُوعُونَ"},{"n":53,"t":"إِلَيٰ مِيقَٰتِ يَوْمٖ مَّعْلُومٖۖ"},{"n":54,"t":"ثُمَّ إِنَّكُمُۥٓ أَيُّهَا اَ۬لضَّآلُّونَ اَ۬لْمُكَذِّبُونَ"},{"n":55,"t":"لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ"},{"n":56,"t":"فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ"},{"n":57,"t":"فَشَٰرِبُونَ عَلَيْهِ مِنَ اَ۬لْحَمِيمِ"},{"n":58,"t":"فَشَٰرِبُونَ شُرْبَ اَ۬لْهِيمِۖ"},{"n":59,"t":"هَٰذَا نُزُلُهُمْ يَوْمَ اَ۬لدِّينِۖ"},{"n":60,"t":"نَحْنُ خَلَقْنَٰكُمْ فَلَوْلَا تُصَدِّقُونَۖ"},{"n":61,"t":"أَفَرَٰٓيْتُم مَّا تُمْنُونَ"},{"n":62,"t":"ءَآنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ اُ۬لْخَٰلِقُونَۖ"},{"n":63,"t":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ اُ۬لْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ"},{"n":64,"t":"عَلَيٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِے مَا لَا تَعْلَمُونَۖ"},{"n":65,"t":"وَلَقَدْ عَلِمْتُمُ اُ۬لنَّشْأَةَ اَ۬لُاول۪يٰ فَلَوْلَا تَذَّكَّرُونَۖ"},{"n":66,"t":"أَفَرَٰٓيْتُم مَّا تَحْرُثُونَ"},{"n":67,"t":"ءَآنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ اُ۬لزَّٰرِعُونَۖ"},{"n":68,"t":"لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰماٗ فَظَلْتُمْ تَفَكَّهُونَ"},{"n":69,"t":"إِنَّا لَمُغْرَمُونَ"},{"n":70,"t":"بَلْ نَحْنُ مَحْرُومُونَۖ"},{"n":71,"t":"أَفَرَٰٓيْتُمُ اُ۬لْمَآءَ اَ۬لذِے تَشْرَبُونَ"},{"n":72,"t":"ءَآنتُمُۥٓ أَنزَلْتُمُوهُ مِنَ اَ۬لْمُزْنِ أَمْ نَحْنُ اُ۬لْمُنزِلُونَۖ"},{"n":73,"t":"لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجاٗ فَلَوْلَا تَشْكُرُونَۖ"},{"n":74,"t":"أَفَرَٰٓيْتُمُ اُ۬لنَّارَ اَ۬لتِے تُورُونَ"},{"n":75,"t":"ءَآنتُمُۥٓ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ اُ۬لْمُن
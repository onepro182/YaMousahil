{"n":78,"name":"النبأ","type":"مكية","count":40,"page":582,"verses":[{"n":1,"t":"عَنِ اِ۬لنَّبَإِ اِ۬لْعَظِيمِ"},{"n":2,"t":"اِ۬لذِے هُمْ فِيهِ مُخْتَلِفُونَۖ"},{"n":3,"t":"كَلَّا سَيَعْلَمُونَ"},{"n":4,"t":"ثُمَّ كَلَّا سَيَعْلَمُونَۖ"},{"n":5,"t":"أَلَمْ نَجْعَلِ اِ۬لَارْضَ مِهَٰداٗ"},{"n":6,"t":"وَالْجِبَالَ أَوْتَاداٗ"},{"n":7,"t":"وَخَلَقْنَٰكُمُۥٓ أَزْوَٰجاٗ"},{"n":8,"t":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتاٗ"},{"n":9,"t":"وَجَعَلْنَا اَ۬ليْلَ لِبَاساٗ"},{"n":10,"t":"وَجَعَلْنَا اَ۬لنَّهَارَ مَعَاشاٗ"},{"n":11,"t":"وَبَنَيْنَا فَوْقَكُمْ سَبْعاٗ شِدَاداٗ"},{"n":12,"t":"وَجَعَلْنَا سِرَاجاٗ وَهَّاجاٗ"},{"n":13,"t":"وَأَنزَلْنَا مِنَ اَ۬لْمُعْصِرَٰتِ مَآءٗ ثَجَّاجاٗ"},{"n":14,"t":"لِّنُخْرِجَ بِهِۦ حَبّاٗ وَنَبَاتاٗ"},{"n":15,"t":"وَجَنَّٰتٍ اَلْفَافاًۖ"},{"n":16,"t":"اِنَّ يَوْمَ اَ۬لْفَصْلِ كَانَ مِيقَٰتاٗ"},{"n":17,"t":"يَوْمَ يُنفَخُ فِے اِ۬لصُّورِ فَتَاتُونَ أَفْوَاجاٗ"},{"n":18,"t":"وَفُتِّحَتِ اِ۬لسَّمَآءُ فَكَانَتَ اَبْوَٰباٗ"},{"n":19,"t":"وَسُيِّرَتِ اِ۬لْجِبَالُ فَكَانَتْ سَرَاباًۖ"},{"n":20,"t":"اِنَّ جَهَنَّمَ كَانَتْ مِرْصَاداٗ"},{"n":21,"t":"لِّلطَّٰغِينَ مَـَٔاباٗ"},{"n":22,"t":"لَّٰبِثِينَ فِيهَآ أَحْقَاباٗۖ"},{"n":23,"t":"لَّا يَذُوقُونَ فِيهَا بَرْداٗ وَلَا شَرَاباً"},{"n":24,"t":"اِلَّا حَمِيماٗ وَغَسَاقاٗ"},{"n":25,"t":"جَزَآءٗ وِفَاقاًۖ"},{"n":26,"t":"اِنَّهُمْ كَانُواْ لَا يَرْجُونَ حِسَاباٗ"},{"n":27,"t":"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّاباٗۖ"},{"n":28,"t":"وَكُلَّ شَےْءٍ اَحْصَيْنَٰهُ كِتَٰباٗۖ"},{"n":29,"t":"فَذُوقُواْ فَلَن نَّزِيدَكُمُۥٓ إِلَّا عَذَاباًۖ"},{"n":30,"t":"اِنَّ لِلْمُتَّقِينَ مَفَازاً"},{"n":31,"t":"حَدَآئِقَ وَأَعْنَٰباٗ"},{"n":32,"t":"وَكَوَاعِبَ أَتْرَاباٗ"},{"n":33,"t":"وَكَأْساٗ دِهَاقاٗ"},{"n":34,"t":"لَّا يَسْمَعُونَ فِيهَا لَغْواٗ وَلَا كِذَّاباٗۖ"},{"n":35,"t":"جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَاباٗۖ"},{"n":36,"t":"رَّبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَاۖ اَ۬لرَّحْمَٰنُ لَا يَمْلِكُونَ مِنْهُ خِطَاباٗۖ"},{"n":37,"t":"يَوْمَ يَقُومُ اُ۬لرُّوحُ وَالْمَلَٰٓئِكَةُ صَفّاٗ لَّا يَتَكَلَّمُونَ إِلَّا مَنَ اَذِنَ لَهُ اُ۬لرَّحْمَٰنُ وَقَالَ صَوَاباٗۖ"},{"n":38,"t":"ذَٰلِكَ اَ۬لْيَوْمُ اُ۬لْحَقُّۖ فَمَن شَآءَ اَ۪تَّخَذَ إِلَيٰ رَبِّهِۦ مَـَٔاباًۖ"},{"n":39,"t":"اِنَّآ أَنذَرْنَٰكُمْ عَذَاباٗ قَرِيباٗ يَوْمَ يَنظُرُ اُ۬لْمَرْءُ مَا قَدَّمَتْ يَدَٰهُ وَيَقُولُ اُ۬لْكَافِرُ يَٰلَيْتَنِے كُنتُ تُرَٰباٗۖ"},{"n":40,"t":"لا تنسنا من دعوة صالحة بظهر الغيب"}]}
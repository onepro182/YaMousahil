{"n":37,"name":"الصافات","type":"مكية","count":182,"page":446,"verses":[{"n":1,"t":"فَالزَّٰجِرَٰتِ زَجْراٗ"},{"n":2,"t":"فَالتَّٰلِيَٰتِ ذِكْراً"},{"n":3,"t":"اِنَّ إِلَٰهَكُمْ لَوَٰحِدٞۖ"},{"n":4,"t":"رَّبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَا وَرَبُّ اُ۬لْمَشَٰرِقِۖ"},{"n":5,"t":"إِنَّا زَيَّنَّا اَ۬لسَّمَآءَ اَ۬لدُّنْي۪ا بِزِينَةِ اِ۬لْكَوَاكِبِۖ"},{"n":6,"t":"وَحِفْظاٗ مِّن كُلِّ شَيْطَٰنٖ مَّارِدٖۖ"},{"n":7,"t":"لَّا يَسْمَعُونَ إِلَي اَ۬لْمَلَإِ اِ۬لَاعْل۪يٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٖۖ"},{"n":8,"t":"دُحُوراٗۖ وَلَهُمْ عَذَابٞ وَاصِبٌ"},{"n":9,"t":"اِلَّا مَنْ خَطِفَ اَ۬لْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٞ ثَاقِبٞۖ"},{"n":10,"t":"فَاسْتَفْتِهِمُۥٓ أَهُمُۥٓ أَشَدُّ خَلْقاً اَم مَّنْ خَلَقْنَآۖ إِنَّا خَلَقْنَٰهُم مِّن طِينٖ لَّٰزِبِۢۖ"},{"n":11,"t":"بَلْ عَجِبْتَ وَيَسْخَرُونَۖ"},{"n":12,"t":"وَإِذَا ذُكِّرُواْ لَا يَذْكُرُونَۖ"},{"n":13,"t":"وَإِذَا رَأَوَاْ اٰيَةٗ يَسْتَسْخِرُونَۖ"},{"n":14,"t":"وَقَالُوٓاْ إِنْ هَٰذَآ إِلَّا سِحْرٞ مُّبِينٌ"},{"n":15,"t":"اَ۟ذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً اِنَّا لَمَبْعُوثُونَ"},{"n":16,"t":"أَوَ ءَابَآؤُنَا اَ۬لَاوَّلُونَۖ"},{"n":17,"t":"قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَۖ"},{"n":18,"t":"فَإِنَّمَا هِيَ زَجْرَةٞ وَٰحِدَةٞ فَإِذَا هُمْ يَنظُرُونَۖ"},{"n":19,"t":"وَقَالُواْ يَٰوَيْلَنَا هَٰذَا يَوْمُ اُ۬لدِّينِۖ"},{"n":20,"t":"هَٰذَا يَوْمُ اُ۬لْفَصْلِ اِ۬لذِے كُنتُم بِهِۦ تُكَذِّبُونَۖ"},{"n":21,"t":"۞اَ۟حْشُرُواْ اُ۬لذِينَ ظَلَمُواْ وَأَزْوَٰجَهُمْ وَمَا كَانُواْ يَعْبُدُونَ"},{"n":22,"t":"مِن دُونِ اِ۬للَّهِ فَاهْدُوهُمُۥٓ إِلَيٰ صِرَٰطِ اِ۬لْجَحِيمِۖ"},{"n":23,"t":"وَقِفُوهُمُۥٓ إِنَّهُم مَّسْـُٔولُونَۖ"},{"n":24,"t":"مَا لَكُمْ لَا تَنَاصَرُونَۖ"},{"n":25,"t":"بَلْ هُمُ اُ۬لْيَوْمَ مُسْتَسْلِمُونَۖ"},{"n":26,"t":"وَأَقْبَلَ بَعْضُهُمْ عَلَيٰ بَعْضٖ يَتَسَآءَلُونَۖ"},{"n":27,"t":"قَالُوٓاْ إِنَّكُمْ كُنتُمْ تَاتُونَنَا عَنِ اِ۬لْيَمِينِۖ"},{"n":28,"t":"قَالُواْ بَل لَّمْ تَكُونُواْ مُومِنِينَۖ"},{"n":29,"t":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنِۢ بَلْ كُنتُمْ قَوْماٗ طَٰغِينَۖ"},{"n":30,"t":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ إِنَّا لَذَآئِقُونَ"},{"n":31,"t":"فَأَغْوَيْنَٰكُمُۥٓ إِنَّا كُنَّا غَٰوِينَۖ"},{"n":32,"t":"فَإِنَّهُمْ يَوْمَئِذٖ فِے اِ۬لْعَذَابِ مُشْتَرِكُونَۖ"},{"n":33,"t":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَۖ"},{"n":34,"t":"إِنَّهُمْ كَانُوٓاْ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا اَ۬للَّهُ يَسْتَكْبِرُونَ"},{"n":35,"t":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرٖ مَّجْنُونِۢۖ"},{"n":36,"t":"بَلْ جَآءَ بِالْحَقِّ وَصَدَّقَ اَ۬لْمُرْسَلِينَۖ"},{"n":37,"t":"إِنَّكُمْ لَذَآئِقُواْ اُ۬لْعَذَابِ اِ۬لَالِيمِۖ"},{"n":38,"t":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ"},{"n":39,"t":"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ"},{"n":40,"t":"أُوْلَٰٓئِكَ لَهُمْ رِزْقٞ مَّعْلُومٞ"},{"n":41,"t":"فَوَٰكِهُۖ وَهُم مُّكْرَمُونَ"},{"n":42,"t":"فِے جَنَّٰتِ اِ۬لنَّعِيمِ"},{"n":43,"t":"عَلَيٰ سُرُرٖ مُّتَقَٰبِلِينَۖ"},{"n":44,"t":"يُطَافُ عَلَيْهِم بِكَأْسٖ مِّن مَّعِينِۢ"},{"n":45,"t":"بَيْضَآءَ لَذَّةٖ لِّلشَّٰرِبِينَ"},{"n":46,"t":"لَا فِيهَا غَوْلٞ وَلَا هُمْ عَنْهَا يُنزَفُونَۖ"},{"n":47,"t":"وَعِندَهُمْ قَٰصِرَٰتُ اُ۬لطَّرْفِ عِينٞ"},{"n":48,"t":"كَأَنَّهُنَّ بَيْضٞ مَّكْنُونٞۖ"},{"n":49,"t":"فَأَقْبَلَ بَعْضُهُمْ عَلَيٰ بَعْضٖ يَتَسَآءَلُونَۖ"},{"n":50,"t":"۞قَالَ قَآئِلٞ مِّنْهُمُۥٓ إِنِّے كَانَ لِے قَرِينٞ"},{"n":51,"t":"يَقُولُ أَ۟نَّكَ لَمِنَ اَ۬لْمُصَدِّقِينَ"},{"n":52,"t":"أَ۟ذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً اِنَّا لَمَدِينُونَۖ"},{"n":53,"t":"قَالَ هَلَ اَنتُم مُّطَّلِعُونَ"},{"n":54,"t":"فَاطَّلَعَ فَر۪ء۪اهُ فِے سَوَآءِ اِ۬لْجَحِيمِۖ"},{"n":55,"t":"قَالَ تَاللَّهِ إِن كِدتَّ لَتُرْدِينِۦ"},{"n":56,"t":"وَلَوْلَا نِعْمَةُ رَبِّے لَكُنتُ مِنَ اَ۬لْمُحْضَرِينَۖ"},{"n":57,"t":"أَفَمَا نَحْنُ بِمَيِّتِينَ"},{"n":58,"t":"إِلَّا مَوْتَتَنَا اَ۬لُاول۪يٰ وَمَا نَحْنُ بِمُعَذَّبِينَۖ"},{"n":59,"t":"إِنَّ هَٰذَا لَهُوَ اَ۬لْفَوْزُ اُ۬لْعَظِيمُۖ"},{"n":60,"t":"لِمِثْلِ هَٰذَا فَلْيَعْمَلِ اِ۬لْعَٰمِلُونَۖ"},{"n":61,"t":"أَذَٰلِكَ خَيْرٞ نُّزُلاً اَمْ شَجَرَةُ اُ۬لزَّقُّومِۖ"},{"n":62,"t":"إِنَّا جَعَلْنَٰهَا فِتْنَةٗ لِّلظَّٰلِمِينَۖ"},{"n":63,"t":"إِنَّهَا شَجَرَةٞ تَخْرُجُ فِےٓ أَصْلِ اِ۬لْجَحِيمِ"},{"n":64,"t":"طَلْعُهَا كَأَنَّهُۥ رُءُوسُ اُ۬لشَّيَٰطِينِۖ"},{"n":65,"t":"فَإِنَّهُمْ لَأٓكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ"},{"n":66,"t":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْباٗ مِّنْ حَمِيمٖۖ"},{"n":67,"t":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَي اَ۬لْجَحِيمِۖ"},{"n":68,"t":"إِنَّهُمُۥٓ أَلْفَوَاْ اٰبَآءَهُمْ ضَآلِّينَ"},{"n":69,"t":"فَهُمْ عَلَيٰٓ ءَاثٰ۪رِهِمْ يُهْرَعُونَۖ"},{"n":70,"t":"وَلَقَد ضَّلَّ قَبْلَهُمُۥٓ أَكْثَرُ اُ۬لَاوَّلِينَۖ"},{"n":71,"t":"وَلَقَدَ اَرْسَلْنَا فِيهِم مُّنذِرِينَۖ"},{"n":72,"t":"فَانظُرْ كَيْفَ كَانَ عَٰقِبَةُ اُ۬لْمُنذَرِينَ"},{"n":73,"t":"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ"},{"n":74,"t":"وَلَقَدْ نَاد۪يٰنَا نُوحٞ فَلَنِعْمَ اَ۬لْمُجِيبُونَۖ"},{"n":75,"t":"وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ"},{"n":76,"t":"وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ اُ۬لْبَاقِينَۖ"},{"n":77,"t":"وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ"},{"n":78,"t":"سَلَٰمٌ عَلَيٰ نُوحٖ فِے اِ۬لْعَٰلَمِينَۖ"},{"n":79,"t":"إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"},{"n":80,"t":"إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ"},{"n":81,"t":"ثُمَّ أَغْرَقْنَا اَ۬لَاخَرِينَۖ"},{"n":82,"t":"۞وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ"},{"n":83,"t":"إِذْ جَآءَ رَبَّهُۥ بِقَلْبٖ سَلِيمٍ"},{"n":84,"t":"اِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَۖ"},{"n":85,"t":"أَئِفْكاً اٰلِهَةٗ دُونَ اَ۬للَّهِ تُرِيدُونَۖ"},{"n":86,"t":"فَمَا ظَنُّكُم بِرَبِّ اِ۬لْعَٰلَمِينَۖ"},{"n":87,"t":"فَنَظَرَ نَظْرَةٗ فِے اِ۬لنُّجُومِ"},{"n":88,"t":"فَقَالَ إِنِّے سَقِيمٞ"},{"n":89,"t":"فَتَوَلَّوْاْ عَنْهُ مُدْبِرِينَۖ"},{"n":90,"t":"فَرَاغَ إِلَيٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَاكُلُونَ"},{"n":91,"t":"مَا لَكُمْ لَا تَنطِقُونَۖ"},{"n":92,"t":"فَرَاغَ عَلَيْهِمْ ضَرْباَۢ بِالْيَمِينِ"},{"n":93,"t":"فَأَقْبَلُوٓاْ إِلَيْهِ يَزِفُّونَۖ"},{"n":94,"t":"قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ"},{"n":95,"t":"وَاللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَۖ"},{"n":96,"t":"قَالُواْ اُ۪بْنُواْ لَهُۥ بُنْيَٰناٗ فَأَلْقُوهُ فِے اِ۬لْجَحِيمِ"},{"n":97,"t":"فَأَرَادُواْ بِهِۦ كَيْداٗ فَجَعَلْنَٰهُمُ اُ۬لَاسْفَلِينَۖ"},{"n":98,"t":"وَقَالَ إِنِّے ذَاهِبٌ اِلَيٰ رَبِّے سَيَهْدِينِۖ"},{"n":99,"t":"رَبِّ هَبْ لِے مِنَ اَ۬لصَّٰلِحِينَۖ"},{"n":100,"t":"فَبَشَّرْنَٰهُ بِغُلَٰمٍ حَلِيمٖۖ"},{"n":101,"t":"فَلَمَّا بَلَغَ مَعَهُ اُ۬لسَّعْيَ قَالَ يَٰبُنَيِّ إِنِّيَ أَر۪يٰ فِے اِ۬لْمَنَامِ أَنِّيَ أَذْبَحُكَ فَانظُرْ مَاذَا تَر۪يٰۖ قَالَ يَٰٓأَبَتِ اِ۪فْعَلْ مَا تُومَرُۖ سَتَجِدُنِيَ إِن شَآءَ اَ۬للَّهُ مِنَ اَ۬لصَّٰبِرِينَۖ"},{"n":102,"t":"فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ"},{"n":103,"t":"وَنَٰدَيْنَٰهُ أَنْ يَّٰٓإِبْرَٰهِيمُ"},{"n":104,"t":"قَدْ صَدَّقْتَ اَ۬لرُّءْي۪آۖ إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"},{"n":105,"t":"إِنَّ هَٰذَا لَهُوَ اَ۬لْبَلَٰٓؤُاْ اُ۬لْمُبِينُۖ"},{"n":106,"t":"وَفَدَيْنَٰهُ بِذِبْحٍ عَظِيمٖۖ"},{"n":107,"t":"وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ"},{"n":108,"t":"سَلَٰمٌ عَلَيٰٓ إِبْرَٰهِيمَۖ"},{"n":109,"t":"كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"},{"n":110,"t":"إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ"},{"n":111,"t":"وَبَشَّرْنَٰهُ بِإِسْحَٰقَ نَبِيٓـٔاٗ مِّنَ اَ۬لصَّٰلِحِينَ"},{"n":112,"t":"وَبَٰرَكْنَا عَلَيْهِ وَعَلَيٰٓ إِسْحَٰقَۖ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٞ وَظَالِمٞ لِّنَفْسِهِۦ مُبِينٞۖ"},{"n":113,"t":"۞وَلَقَدْ مَنَنَّا عَلَيٰ مُوس۪يٰ وَهَٰرُونَ"},{"n":114,"t":"وَنَجَّيْنَٰهُمَا وَقَوْمَهُمَا مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ"},{"n":115,"t":"وَنَصَرْنَٰهُمْ فَكَانُواْ هُمُ اُ۬لْغَٰلِبِينَۖ"},{"n":116,"t":"وَءَاتَيْنَٰهُمَا اَ۬لْكِتَٰبَ اَ۬لْمُسْتَبِينَۖ"},{"n":117,"t":"وَهَدَيْنَٰهُمَا اَ۬لصِّرَٰطَ اَ۬لْمُسْتَقِيمَۖ"},{"n":118,"t":"وَتَرَكْنَا عَلَيْهِمَا فِے اِ۬لَاخِرِينَۖ"},{"n":119,"t":"سَلَٰمٌ عَلَيٰ مُوس۪يٰ وَهَٰرُونَۖ"},{"n":120,"t":"إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"},{"n":121,"t":"إِنَّهُمَا مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ"},{"n":122,"t":"وَإِنَّ إِلْيَاسَ لَمِنَ اَ۬لْمُرْسَلِينَ"},{"n":123,"t":"إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ"},{"n":124,"t":"أَتَدْعُونَ بَعْلاٗ وَتَذَرُونَ أَحْسَنَ اَ۬لْخَٰلِقِينَۖ"},{"n":125,"t":"اَ۬للَّهُ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ اُ۬لَاوَّلِينَۖ"},{"n":126,"t":"فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ"},{"n":127,"t":"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ"},{"n":128,"t":"وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ"},{"n":129,"t":"سَلَٰمٌ عَلَيٰٓ ءَالِ يَاسِينَۖ"},{"n":130,"t":"إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"},{"n":131,"t":"إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ"},{"n":132,"t":"وَإِنَّ لُوطاٗ لَّمِنَ اَ۬لْمُرْسَلِينَ"},{"n":133,"t":"إِذْ نَجَّيْنَٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ"},{"n":134,"t":"إِلَّا عَجُوزاٗ فِے اِ۬لْغَٰبِرِينَ"},{"n":135,"t":"ثُمَّ دَمَّرْنَا اَ۬لَاخَرِينَۖ"},{"n":136,"t":"وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ"},{"n":137,"t":"وَبِاليْلِۖ أَفَلَا تَعْقِلُونَۖ"},{"n":138,"t":"وَإِنَّ يُونُسَ لَمِنَ اَ۬لْمُرْسَلِينَ"},{"n":139,"t":"إِذَ اَبَقَ إِلَي اَ۬لْفُلْكِ اِ۬لْمَشْحُونِ"},{"n":140,"t":"فَسَاهَمَ فَكَانَ مِنَ اَ۬لْمُدْحَضِينَ"},{"n":141,"t":"فَالْتَقَمَهُ اُ۬لْحُوتُ وَهُوَ مُلِيمٞۖ"},{"n":142,"t":"فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ اَ۬لْمُسَبِّحِينَ"},{"n":143,"t":"لَلَبِثَ فِے بَطْنِهِۦٓ إِلَيٰ يَوْمِ يُبْعَثُونَۖ"},{"n":144,"t":"۞فَنَبَذْنَٰهُ بِالْعَرَآءِ وَهُوَ سَقِيمٞۖ"},{"n":145,"t":"وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةٗ مِّنْ يَّقْطِينٖۖ"},{"n":146,"t":"وَأَرْسَلْنَٰهُ إِلَيٰ مِاْئَةِ أَلْفٍ اَوْ يَزِيدُونَۖ"},{"n":147,"t":"فَـَٔامَنُواْ فَمَتَّعْنَٰهُمُۥٓ إِلَيٰ حِينٖۖ"},{"n":148,"t":"فَاسْتَفْتِهِمُۥٓ أَلِرَبِّكَ اَ۬لْبَنَاتُ وَلَهُمُ اُ۬لْبَنُونَۖ"},{"n":149,"t":"أَمْ خَلَقْنَا اَ۬لْمَلَٰٓئِكَةَ إِنَٰثاٗ وَهُمْ شَٰهِدُونَۖ"},{"n":150,"t":"أَلَآ إِنَّهُم مِّنِ اِفْكِهِمْ لَيَقُولُونَ"},{"n":151,"t":"وَلَدَ اَ۬للَّهُ وَإِنَّهُمْ لَكَٰذِبُونَۖ"},{"n":152,"t":"أَصْطَفَي اَ۬لْبَنَاتِ عَلَي اَ۬لْبَنِينَۖ"},{"n":153,"t":"مَا لَكُمْ كَيْفَ تَحْكُمُونَۖ"},{"n":154,"t":"أَفَلَا تَذَّكَّرُونَۖ"},{"n":155,"t":"أَمْ لَكُمْ سُلْطَٰنٞ مُّبِينٞ"},{"n":156,"t":"فَاتُواْ بِكِتَٰبِكُمُۥٓ إِن كُنتُمْ صَٰدِقِينَۖ"},{"n":157,"t":"وَجَعَلُواْ بَيْنَهُۥ وَبَيْنَ اَ۬لْجِنَّةِ نَسَباٗۖ وَلَقَدْ عَلِمَتِ اِ۬لْجِنَّةُ إِنّ
{"n":92,"name":"الليل","type":"مكية","count":21,"page":595,"verses":[{"n":1,"t":"وَاليْلِ إِذَا يَغْش۪يٰ"},{"n":2,"t":"وَالنَّه۪ارِ إِذَا تَجَلّ۪يٰ"},{"n":3,"t":"وَمَا خَلَقَ اَ۬لذَّكَرَ وَالُانث۪يٰٓ"},{"n":4,"t":"إِنَّ سَعْيَكُمْ لَشَتّ۪يٰۖ"},{"n":5,"t":"فَأَمَّا مَنَ اَعْط۪يٰ وَاتَّق۪يٰ"},{"n":6,"t":"وَصَدَّقَ بِالْحُسْن۪يٰ"},{"n":7,"t":"فَسَنُيَسِّرُهُۥ لِلْيُسْر۪يٰۖ"},{"n":8,"t":"وَأَمَّا مَنۢ بَخِلَ وَاسْتَغْن۪يٰ"},{"n":9,"t":"وَكَذَّبَ بِالْحُسْن۪يٰ"},{"n":10,"t":"فَسَنُيَسِّرُهُۥ لِلْعُسْر۪يٰۖ"},{"n":11,"t":"وَمَا يُغْنِے عَنْهُ مَالُهُۥٓ إِذَا تَرَدّ۪يٰٓۖ"},{"n":12,"t":"إِنَّ عَلَيْنَا لَلْهُد۪يٰ"},{"n":13,"t":"وَإِنَّ لَنَا لَلَاخِرَةَ وَالُاول۪يٰۖ"},{"n":14,"t":"فَأَنذَرْتُكُمْ نَاراٗ تَلَظّ۪يٰ"},{"n":15,"t":"لَا يَصْلَيٰهَآ إِلَّا اَ۬لَاشْقَي"},{"n":16,"t":"اَ۬لذِے كَذَّبَ وَتَوَلّ۪يٰۖ"},{"n":17,"t":"وَسَيُجَنَّبُهَا اَ۬لَاتْقَي"},{"n":18,"t":"اَ۬لذِے يُوتِے مَالَهُۥ يَتَزَكّ۪يٰۖ"},{"n":19,"t":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٖ تُجْز۪يٰٓ"},{"n":20,"t":"إِلَّا اَ۪بْتِغَآءَ وَجْهِ رَبِّهِ اِ۬لَاعْل۪يٰۖ"},{"n":21,"t":"وَلَسَوْفَ يَرْض۪يٰۖ"}]}
{"n":92,"name":"الليل","type":"مكية","count":21,"page":595,"verses":[{"n":1,"t":"وَالنَّه۪ارِ إِذَا تَجَلّ۪يٰ"},{"n":2,"t":"وَمَا خَلَقَ اَ۬لذَّكَرَ وَالُانث۪يٰٓ"},{"n":3,"t":"إِنَّ سَعْيَكُمْ لَشَتّ۪يٰۖ"},{"n":4,"t":"فَأَمَّا مَنَ اَعْط۪يٰ وَاتَّق۪يٰ"},{"n":5,"t":"وَصَدَّقَ بِالْحُسْن۪يٰ"},{"n":6,"t":"فَسَنُيَسِّرُهُۥ لِلْيُسْر۪يٰۖ"},{"n":7,"t":"وَأَمَّا مَنۢ بَخِلَ وَاسْتَغْن۪يٰ"},{"n":8,"t":"وَكَذَّبَ بِالْحُسْن۪يٰ"},{"n":9,"t":"فَسَنُيَسِّرُهُۥ لِلْعُسْر۪يٰۖ"},{"n":10,"t":"وَمَا يُغْنِے عَنْهُ مَالُهُۥٓ إِذَا تَرَدّ۪يٰٓۖ"},{"n":11,"t":"إِنَّ عَلَيْنَا لَلْهُد۪يٰ"},{"n":12,"t":"وَإِنَّ لَنَا لَلَاخِرَةَ وَالُاول۪يٰۖ"},{"n":13,"t":"فَأَنذَرْتُكُمْ نَاراٗ تَلَظّ۪يٰ"},{"n":14,"t":"لَا يَصْلَيٰهَآ إِلَّا اَ۬لَاشْقَي"},{"n":15,"t":"اَ۬لذِے كَذَّبَ وَتَوَلّ۪يٰۖ"},{"n":16,"t":"وَسَيُجَنَّبُهَا اَ۬لَاتْقَي"},{"n":17,"t":"اَ۬لذِے يُوتِے مَالَهُۥ يَتَزَكّ۪يٰۖ"},{"n":18,"t":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٖ تُجْز۪يٰٓ"},{"n":19,"t":"إِلَّا اَ۪بْتِغَآءَ وَجْهِ رَبِّهِ اِ۬لَاعْل۪يٰۖ"},{"n":20,"t":"وَلَسَوْفَ يَرْض۪يٰۖ"},{"n":21,"t":"لا تنسنا من دعوة صالحة بظهر الغيب"}]}
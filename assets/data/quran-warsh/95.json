{"n":95,"name":"التين","type":"مكية","count":8,"page":597,"verses":[{"n":1,"t":"وَالتِّينِ وَالزَّيْتُونِ"},{"n":2,"t":"وَطُورِ سِينِينَ"},{"n":3,"t":"وَهَٰذَا اَ۬لْبَلَدِ اِ۬لَامِينِ"},{"n":4,"t":"لَقَدْ خَلَقْنَا اَ۬لِانسَٰنَ فِےٓ أَحْسَنِ تَقْوِيمٖ"},{"n":5,"t":"ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ"},{"n":6,"t":"إِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ فَلَهُمُۥٓ أَجْرٌ غَيْرُ مَمْنُونٖۖ"},{"n":7,"t":"فَمَا يُكَذِّبُكَ بَعْدُ بِالدِّينِۖ"},{"n":8,"t":"أَلَيْسَ اَ۬للَّهُ بِأَحْكَمِ اِ۬لْحَٰكِمِينَۖ"}]}
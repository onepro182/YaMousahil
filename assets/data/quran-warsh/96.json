{"n":96,"name":"العلق","type":"مكية","count":19,"page":597,"verses":[{"n":1,"t":"خَلَقَ اَ۬لِانسَٰنَ مِنْ عَلَقٍۖ"},{"n":2,"t":"اِ۪قْرَأْ وَرَبُّكَ اَ۬لَاكْرَمُ"},{"n":3,"t":"اُ۬لذِے عَلَّمَ بِالْقَلَمِ"},{"n":4,"t":"عَلَّمَ اَ۬لِانسَٰنَ مَا لَمْ يَعْلَمْۖ"},{"n":5,"t":"كَلَّآ إِنَّ اَ۬لِانسَٰنَ لَيَطْغ۪يٰٓ"},{"n":6,"t":"أَن رّ۪ء۪اهُ اُ۪سْتَغْن۪يٰٓۖ"},{"n":7,"t":"إِنَّ إِلَيٰ رَبِّكَ اَ۬لرُّجْع۪يٰٓۖ"},{"n":8,"t":"أَرَٰٓيْتَ اَ۬لذِے يَنْه۪يٰ"},{"n":9,"t":"عَبْداً اِذَا صَلّ۪يٰٓۖ"},{"n":10,"t":"أَرَٰٓيْتَ إِن كَانَ عَلَي اَ۬لْهُد۪يٰٓ"},{"n":11,"t":"أَوَ اَمَرَ بِالتَّقْو۪يٰٓ"},{"n":12,"t":"أَرَٰٓيْتَ إِن كَذَّبَ وَتَوَلّ۪يٰٓ"},{"n":13,"t":"أَلَمْ يَعْلَم بِأَنَّ اَ۬للَّهَ يَر۪يٰۖ"},{"n":14,"t":"كَلَّا لَئِن لَّمْ يَنتَهِ"},{"n":15,"t":"لَنَسْفَعاَۢ بِالنَّاصِيَةِ"},{"n":16,"t":"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖۖ"},{"n":17,"t":"فَلْيَدْعُ نَادِيَهُۥ"},{"n":18,"t":"سَنَدْعُ اُ۬لزَّبَانِيَةَۖ"},{"n":19,"t":"كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبِۖ۩"},{"n":20,"t":"لا تنسنا من دعوة صالحة بظهر الغيب"}]}
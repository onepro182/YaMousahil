{"n":96,"name":"العلق","type":"مكية","count":19,"page":597,"verses":[{"n":1,"t":"اَ۪قْرَأْ بِاسْمِ رَبِّكَ اَ۬لذِے خَلَقَۖ"},{"n":2,"t":"خَلَقَ اَ۬لِانسَٰنَ مِنْ عَلَقٍۖ"},{"n":3,"t":"اِ۪قْرَأْ وَرَبُّكَ اَ۬لَاكْرَمُ"},{"n":4,"t":"اُ۬لذِے عَلَّمَ بِالْقَلَمِ"},{"n":5,"t":"عَلَّمَ اَ۬لِانسَٰنَ مَا لَمْ يَعْلَمْۖ"},{"n":6,"t":"كَلَّآ إِنَّ اَ۬لِانسَٰنَ لَيَطْغ۪يٰٓ"},{"n":7,"t":"أَن رّ۪ء۪اهُ اُ۪سْتَغْن۪يٰٓۖ"},{"n":8,"t":"إِنَّ إِلَيٰ رَبِّكَ اَ۬لرُّجْع۪يٰٓۖ"},{"n":9,"t":"أَرَٰٓيْتَ اَ۬لذِے يَنْه۪يٰ"},{"n":10,"t":"عَبْداً اِذَا صَلّ۪يٰٓۖ"},{"n":11,"t":"أَرَٰٓيْتَ إِن كَانَ عَلَي اَ۬لْهُد۪يٰٓ"},{"n":12,"t":"أَوَ اَمَرَ بِالتَّقْو۪يٰٓ"},{"n":13,"t":"أَرَٰٓيْتَ إِن كَذَّبَ وَتَوَلّ۪يٰٓ"},{"n":14,"t":"أَلَمْ يَعْلَم بِأَنَّ اَ۬للَّهَ يَر۪يٰۖ"},{"n":15,"t":"كَلَّا لَئِن لَّمْ يَنتَهِ"},{"n":16,"t":"لَنَسْفَعاَۢ بِالنَّاصِيَةِ"},{"n":17,"t":"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖۖ"},{"n":18,"t":"فَلْيَدْعُ نَادِيَهُۥ"},{"n":19,"t":"سَنَدْعُ اُ۬لزَّبَانِيَةَۖ"},{"n":20,"t":"كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبِۖ۩"}]}
{"n":90,"name":"البلد","type":"مكية","count":20,"page":594,"verses":[{"n":1,"t":"وَأَنتَ حِلُّۢ بِهَٰذَا اَ۬لْبَلَدِ"},{"n":2,"t":"وَوَالِدٖ وَمَا وَلَدَ"},{"n":3,"t":"لَقَدْ خَلَقْنَا اَ۬لِانسَٰنَ فِے كَبَدٍۖ"},{"n":4,"t":"اَيَحْسِبُ أَن لَّنْ يَّقْدِرَ عَلَيْهِ أَحَدٞ"},{"n":5,"t":"يَقُولُ أَهْلَكْتُ مَالاٗ لُّبَداًۖ"},{"n":6,"t":"اَيَحْسِبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌۖ"},{"n":7,"t":"اَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ"},{"n":8,"t":"وَلِسَاناٗ وَشَفَتَيْنِ"},{"n":9,"t":"وَهَدَيْنَٰهُ اُ۬لنَّجْدَيْنِۖ"},{"n":10,"t":"فَلَا اَ۪قْتَحَمَ اَ۬لْعَقَبَةَۖ"},{"n":11,"t":"وَمَآ أَدْر۪يٰكَ مَا اَ۬لْعَقَبَةُۖ"},{"n":12,"t":"فَكُّ رَقَبَةٍ"},{"n":13,"t":"اَوِ اِطْعَامٞ فِے يَوْمٖ ذِے مَسْغَبَةٖ"},{"n":14,"t":"يَتِيماٗ ذَا مَقْرَبَةٍ"},{"n":15,"t":"اَوْ مِسْكِيناٗ ذَا مَتْرَبَةٖۖ"},{"n":16,"t":"ثُمَّ كَانَ مِنَ اَ۬لذِينَ ءَامَنُواْ وَتَوَاصَوْاْ بِالصَّبْرِ وَتَوَاصَوْاْ بِالْمَرْحَمَةِۖ"},{"n":17,"t":"أُوْلَٰٓئِكَ أَصْحَٰبُ اُ۬لْمَيْمَنَةِۖ"},{"n":18,"t":"وَالذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمُۥٓ أَصْحَٰبُ اُ۬لْمَشْـَٔمَةِۖ"},{"n":19,"t":"عَلَيْهِمْ نَارٞ مُّوصَدَةٞۖ"},{"n":20,"t":"لا تنسنا من دعوة صالحة بظهر الغيب"}]}
{"n":90,"name":"البلد","type":"مكية","count":20,"page":594,"verses":[{"n":1,"t":"لَآ أُقْسِمُ بِهَٰذَا اَ۬لْبَلَدِ"},{"n":2,"t":"وَأَنتَ حِلُّۢ بِهَٰذَا اَ۬لْبَلَدِ"},{"n":3,"t":"وَوَالِدٖ وَمَا وَلَدَ"},{"n":4,"t":"لَقَدْ خَلَقْنَا اَ۬لِانسَٰنَ فِے كَبَدٍۖ"},{"n":5,"t":"اَيَحْسِبُ أَن لَّنْ يَّقْدِرَ عَلَيْهِ أَحَدٞ"},{"n":6,"t":"يَقُولُ أَهْلَكْتُ مَالاٗ لُّبَداًۖ"},{"n":7,"t":"اَيَحْسِبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌۖ"},{"n":8,"t":"اَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ"},{"n":9,"t":"وَلِسَاناٗ وَشَفَتَيْنِ"},{"n":10,"t":"وَهَدَيْنَٰهُ اُ۬لنَّجْدَيْنِۖ"},{"n":11,"t":"فَلَا اَ۪قْتَحَمَ اَ۬لْعَقَبَةَۖ"},{"n":12,"t":"وَمَآ أَدْر۪يٰكَ مَا اَ۬لْعَقَبَةُۖ"},{"n":13,"t":"فَكُّ رَقَبَةٍ"},{"n":14,"t":"اَوِ اِطْعَامٞ فِے يَوْمٖ ذِے مَسْغَبَةٖ"},{"n":15,"t":"يَتِيماٗ ذَا مَقْرَبَةٍ"},{"n":16,"t":"اَوْ مِسْكِيناٗ ذَا مَتْرَبَةٖۖ"},{"n":17,"t":"ثُمَّ كَانَ مِنَ اَ۬لذِينَ ءَامَنُواْ وَتَوَاصَوْاْ بِالصَّبْرِ وَتَوَاصَوْاْ بِالْمَرْحَمَةِۖ"},{"n":18,"t":"أُوْلَٰٓئِكَ أَصْحَٰبُ اُ۬لْمَيْمَنَةِۖ"},{"n":19,"t":"وَالذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمُۥٓ أَصْحَٰبُ اُ۬لْمَشْـَٔمَةِۖ"},{"n":20,"t":"عَلَيْهِمْ نَارٞ مُّوصَدَةٞۖ"}]}
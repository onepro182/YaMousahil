{"n":84,"name":"الانشقاق","type":"مكية","count":25,"page":589,"verses":[{"n":1,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"n":2,"t":"وَإِذَا اَ۬لَارْضُ مُدَّتْ"},{"n":3,"t":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"},{"n":4,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْۖ"},{"n":5,"t":"يَٰٓأَيُّهَا اَ۬لِانسَٰنُ إِنَّكَ كَادِحٌ اِلَيٰ رَبِّكَ كَدْحاٗ فَمُلَٰقِيهِۖ"},{"n":6,"t":"فَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ"},{"n":7,"t":"فَسَوْفَ يُحَاسَبُ حِسَاباٗ يَسِيراٗ"},{"n":8,"t":"وَيَنقَلِبُ إِلَيٰٓ أَهْلِهِۦ مَسْرُوراٗۖ"},{"n":9,"t":"وَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ"},{"n":10,"t":"فَسَوْفَ يَدْعُواْ ثُبُوراٗ"},{"n":11,"t":"وَيُصَلَّيٰ سَعِيراًۖ"},{"n":12,"t":"اِنَّهُۥ كَانَ فِےٓ أَهْلِهِۦ مَسْرُوراًۖ"},{"n":13,"t":"اِنَّهُۥ ظَنَّ أَن لَّنْ يَّحُورَ"},{"n":14,"t":"بَل۪يٰٓۖ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيراٗۖ"},{"n":15,"t":"۞فَلَآ أُقْسِمُ بِالشَّفَقِ"},{"n":16,"t":"وَاليْلِ وَمَا وَسَقَ"},{"n":17,"t":"وَالْقَمَرِ إِذَا اَ۪تَّسَقَ"},{"n":18,"t":"لَتَرْكَبُنَّ طَبَقاً عَن طَبَقٖۖ"},{"n":19,"t":"فَمَا لَهُمْ لَا يُومِنُونَ"},{"n":20,"t":"وَإِذَا قُرِۓَ عَلَيْهِمُ اُ۬لْقُرْءَانُ لَا يَسْجُدُونَ۩ۖ"},{"n":21,"t":"بَلِ اِ۬لذِينَ كَفَرُواْ يُكَذِّبُونَ"},{"n":22,"t":"وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَۖ"},{"n":23,"t":"فَبَشِّرْهُم بِعَذَابٍ اَلِيمٍۖ"},{"n":24,"t":"اِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمُۥٓ أَجْرٌ غَيْرُ مَمْنُونٖۖ"},{"n":25,"t":"لا تنسنا من دعوة صالحة بظهر الغيب"}]}
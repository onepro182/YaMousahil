{"n":79,"name":"النازعات","type":"مكية","count":46,"page":583,"verses":[{"n":1,"t":"وَالنَّٰشِطَٰتِ نَشْطاٗ"},{"n":2,"t":"وَالسَّٰبِحَٰتِ سَبْحاٗ"},{"n":3,"t":"فَالسَّٰبِقَٰتِ سَبْقاٗ"},{"n":4,"t":"فَالْمُدَبِّرَٰتِ أَمْراٗ"},{"n":5,"t":"يَوْمَ تَرْجُفُ اُ۬لرَّاجِفَةُ"},{"n":6,"t":"تَتْبَعُهَا اَ۬لرَّادِفَةُۖ"},{"n":7,"t":"قُلُوبٞ يَوْمَئِذٖ وَاجِفَةٌ"},{"n":8,"t":"اَبْصَٰرُهَا خَٰشِعَةٞۖ"},{"n":9,"t":"يَقُولُونَ أَ۟نَّا لَمَرْدُودُونَ فِے اِ۬لْحَافِرَةِ"},{"n":10,"t":"إِذَا كُنَّا عِظَٰماٗ نَّخِرَةٗۖ"},{"n":11,"t":"قَالُواْ تِلْكَ إِذاٗ كَرَّةٌ خَاسِرَةٞ"},{"n":12,"t":"فَإِنَّمَا هِيَ زَجْرَةٞ وَٰحِدَةٞ"},{"n":13,"t":"فَإِذَا هُم بِالسَّاهِرَةِۖ"},{"n":14,"t":"هَلَ اَت۪يٰكَ حَدِيثُ مُوس۪يٰٓ"},{"n":15,"t":"إِذْ نَاد۪يٰهُ رَبُّهُۥ بِالْوَادِ اِ۬لْمُقَدَّسِ طُوَيۖ"},{"n":16,"t":"اَ۪ذْهَبِ اِلَيٰ فِرْعَوْنَ إِنَّهُۥ طَغ۪يٰ"},{"n":17,"t":"فَقُلْ هَل لَّكَ إِلَيٰٓ أَن تَزَّكّ۪يٰ"},{"n":18,"t":"وَأَهْدِيَكَ إِلَيٰ رَبِّكَ فَتَخْش۪يٰۖ"},{"n":19,"t":"فَأَر۪يٰهُ اُ۬لَايَةَ اَ۬لْكُبْر۪يٰ"},{"n":20,"t":"فَكَذَّبَ وَعَص۪يٰ"},{"n":21,"t":"ثُمَّ أَدْبَرَ يَسْع۪يٰ"},{"n":22,"t":"فَحَشَرَ فَنَاد۪يٰ"},{"n":23,"t":"فَقَالَ أَنَا رَبُّكُمُ اُ۬لَاعْل۪يٰ"},{"n":24,"t":"فَأَخَذَهُ اُ۬للَّهُ نَكَالَ اَ۬لَاخِرَةِ وَالُاول۪يٰٓۖ"},{"n":25,"t":"إِنَّ فِے ذَٰلِكَ لَعِبْرَةٗ لِّمَنْ يَّخْش۪يٰٓۖ"},{"n":26,"t":"ءَآنتُمُۥٓ أَشَدُّ خَلْقاً اَمِ اِ۬لسَّمَآءُۖ بَنَيٰهَا"},{"n":27,"t":"رَفَعَ سَمْكَهَا فَسَوَّيٰهَا"},{"n":28,"t":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَيٰهَاۖ"},{"n":29,"t":"وَالَارْضَ بَعْدَ ذَٰلِكَ دَحَيٰهَآ"},{"n":30,"t":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَيٰهَا"},{"n":31,"t":"وَالْجِبَالَ أَرْسَيٰهَا"},{"n":32,"t":"مَتَٰعاٗ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ"},{"n":33,"t":"فَإِذَا جَآءَتِ اِ۬لطَّآمَّةُ اُ۬لْكُبْر۪يٰ"},{"n":34,"t":"يَوْمَ يَتَذَكَّرُ اُ۬لِانسَٰنُ مَا سَع۪يٰ"},{"n":35,"t":"وَبُرِّزَتِ اِ۬لْجَحِيمُ لِمَنْ يَّر۪يٰۖ"},{"n":36,"t":"فَأَمَّا مَن طَغ۪يٰ وَءَاثَرَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْي۪ا"},{"n":37,"t":"فَإِنَّ اَ۬لْجَحِيمَ هِيَ اَ۬لْمَأْو۪يٰۖ"},{"n":38,"t":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَي اَ۬لنَّفْسَ عَنِ اِ۬لْهَو۪يٰ"},{"n":39,"t":"فَإِنَّ اَ۬لْجَنَّةَ هِيَ اَ۬لْمَأْو۪يٰۖ"},{"n":40,"t":"۞يَسْـَٔلُونَكَ عَنِ اِ۬لسَّاعَةِ أَيَّانَ مُرْسَيٰهَاۖ"},{"n":41,"t":"فِيمَ أَنتَ مِن ذِكْر۪يٰهَآۖ"},{"n":42,"t":"إِلَيٰ رَبِّكَ مُنتَهَيٰهَآۖ"},{"n":43,"t":"إِنَّمَآ أَنتَ مُنذِرُ مَنْ يَّخْشَيٰهَاۖ"},{"n":44,"t":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓاْ إِلَّا عَشِيَّةً اَوْ ضُحَيٰهَاۖ"},{"n":45,"t":"لا تنسنا من دعوة صالحة بظهر الغيب"}]}
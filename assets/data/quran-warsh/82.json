{"n":82,"name":"الإنفطار","type":"مكية","count":19,"page":587,"verses":[{"n":1,"t":"وَإِذَا اَ۬لْكَوَاكِبُ اُ۪نتَثَرَتْ"},{"n":2,"t":"وَإِذَا اَ۬لْبِحَارُ فُجِّرَتْ"},{"n":3,"t":"وَإِذَا اَ۬لْقُبُورُ بُعْثِرَتْ"},{"n":4,"t":"عَلِمَتْ نَفْسٞ مَّا قَدَّمَتْ وَأَخَّرَتْۖ"},{"n":5,"t":"يَٰٓأَيُّهَا اَ۬لِانسَٰنُ مَا غَرَّكَ بِرَبِّكَ اَ۬لْكَرِيمِ"},{"n":6,"t":"اِ۬لذِے خَلَقَكَ فَسَوّ۪يٰكَ فَعَدَّلَكَ"},{"n":7,"t":"فِےٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَۖ"},{"n":8,"t":"كَلَّا بَلْ تُكَذِّبُونَ بِالدِّينِ"},{"n":9,"t":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ"},{"n":10,"t":"كِرَاماٗ كَٰتِبِينَ"},{"n":11,"t":"يَعْلَمُونَ مَا تَفْعَلُونَۖ"},{"n":12,"t":"إِنَّ اَ۬لَابْرَارَ لَفِے نَعِيمٖۖ"},{"n":13,"t":"وَإِنَّ اَ۬لْفُجَّارَ لَفِے جَحِيمٖ"},{"n":14,"t":"يَصْلَوْنَهَا يَوْمَ اَ۬لدِّينِ"},{"n":15,"t":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَۖ"},{"n":16,"t":"وَمَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لدِّينِ"},{"n":17,"t":"ثُمَّ مَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لدِّينِۖ"},{"n":18,"t":"يَوْمَ لَا تَمْلِكُ نَفْسٞ لِّنَفْسٖ شَيْـٔاٗۖ وَالَامْرُ يَوْمَئِذٖ لِّلهِۖ"},{"n":19,"t":"لا تنسنا من دعوة صالحة بظهر الغيب"}]}
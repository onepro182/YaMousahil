{"n":86,"name":"الطارق","type":"مكية","count":17,"page":591,"verses":[{"n":1,"t":"وَالسَّمَآءِ وَالطَّارِقِ"},{"n":2,"t":"وَمَآ أَدْر۪يٰكَ مَا اَ۬لطَّارِقُ"},{"n":3,"t":"اُ۬لنَّجْمُ اُ۬لثَّاقِبُ"},{"n":4,"t":"إِن كُلُّ نَفْسٖ لَّمَا عَلَيْهَا حَافِظٞۖ"},{"n":5,"t":"فَلْيَنظُرِ اِ۬لِانسَٰنُ مِمَّ خُلِقَۖ"},{"n":6,"t":"خُلِقَ مِن مَّآءٖ دَافِقٖ"},{"n":7,"t":"يَخْرُجُ مِنۢ بَيْنِ اِ۬لصُّلْبِ وَالتَّرَآئِبِۖ"},{"n":8,"t":"إِنَّهُۥ عَلَيٰ رَجْعِهِۦ لَقَادِرٞ"},{"n":9,"t":"يَوْمَ تُبْلَي اَ۬لسَّرَآئِرُ"},{"n":10,"t":"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖۖ"},{"n":11,"t":"وَالسَّمَآءِ ذَاتِ اِ۬لرَّجْعِ"},{"n":12,"t":"وَالَارْضِ ذَاتِ اِ۬لصَّدْعِ"},{"n":13,"t":"إِنَّهُۥ لَقَوْلٞ فَصْلٞ"},{"n":14,"t":"وَمَا هُوَ بِالْهَزْلِۖ"},{"n":15,"t":"إِنَّهُمْ يَكِيدُونَ كَيْداٗ"},{"n":16,"t":"وَأَكِيدُ كَيْداٗۖ"},{"n":17,"t":"فَمَهِّلِ اِ۬لْكٰ۪فِرِينَ أَمْهِلْهُمْ رُوَيْداٗۖ"}]}
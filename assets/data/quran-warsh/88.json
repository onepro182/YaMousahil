{"n":88,"name":"الغاشية","type":"مكية","count":26,"page":592,"verses":[{"n":1,"t":"وُجُوهٞ يَوْمَئِذٍ خَٰشِعَةٌ"},{"n":2,"t":"عَامِلَةٞ نَّاصِبَةٞ"},{"n":3,"t":"تَصْلَيٰ نَاراً حَامِيَةٗ"},{"n":4,"t":"تُسْق۪يٰ مِنْ عَيْنٍ اٰنِيَةٖۖ"},{"n":5,"t":"لَّيْسَ لَهُمْ طَعَامٌ اِلَّا مِن ضَرِيعٖ"},{"n":6,"t":"لَّا يُسْمِنُ وَلَا يُغْنِے مِن جُوعٖۖ"},{"n":7,"t":"وُجُوهٞ يَوْمَئِذٖ نَّاعِمَةٞ"},{"n":8,"t":"لِّسَعْيِهَا رَاضِيَةٞ"},{"n":9,"t":"فِے جَنَّةٍ عَالِيَةٖ"},{"n":10,"t":"لَّا تُسْمَعُ فِيهَا لَٰغِيَةٞۖ"},{"n":11,"t":"فِيهَا عَيْنٞ جَارِيَةٞۖ"},{"n":12,"t":"فِيهَا سُرُرٞ مَّرْفُوعَةٞ"},{"n":13,"t":"وَأَكْوَابٞ مَّوْضُوعَةٞ"},{"n":14,"t":"وَنَمَارِقُ مَصْفُوفَةٞ"},{"n":15,"t":"وَزَرَابِيُّ مَبْثُوثَةٌۖ"},{"n":16,"t":"۞اَفَلَا يَنظُرُونَ إِلَي اَ۬لِابِلِ كَيْفَ خُلِقَتْ"},{"n":17,"t":"وَإِلَي اَ۬لسَّمَآءِ كَيْفَ رُفِعَتْ"},{"n":18,"t":"وَإِلَي اَ۬لْجِبَالِ كَيْفَ نُصِبَتْ"},{"n":19,"t":"وَإِلَي اَ۬لَارْضِ كَيْفَ سُطِحَتْۖ"},{"n":20,"t":"فَذَكِّرِ اِنَّمَآ أَنتَ مُذَكِّرٞۖ"},{"n":21,"t":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍۖ"},{"n":22,"t":"اِلَّا مَن تَوَلّ۪يٰ وَكَفَرَ"},{"n":23,"t":"فَيُعَذِّبُهُ اُ۬للَّهُ اُ۬لْعَذَابَ اَ۬لَاكْبَرَۖ"},{"n":24,"t":"إِنَّ إِلَيْنَآ إِيَابَهُمْ"},{"n":25,"t":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُمْۖ"},{"n":26,"t":"لا تنسنا من دعوة صالحة بظهر الغيب"}]}
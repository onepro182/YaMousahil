{"n":107,"name":"الماعون","type":"مكية","count":7,"page":602,"verses":[{"n":1,"t":"فَذَٰلِكَ اَ۬لذِے يَدُعُّ اُ۬لْيَتِيمَ"},{"n":2,"t":"وَلَا يَحُضُّ عَلَيٰ طَعَامِ اِ۬لْمِسْكِينِۖ"},{"n":3,"t":"فَوَيْلٞ لِّلْمُصَلِّينَ"},{"n":4,"t":"اَ۬لذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"},{"n":5,"t":"اَ۬لذِينَ هُمْ يُرَآءُونَ وَيَمْنَعُونَ اَ۬لْمَاعُونَۖ"},{"n":6,"t":"لا تنسنا من دعوة صالحة بظهر الغيب"}]}